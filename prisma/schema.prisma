generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanTier {
  BASICO
  EMPRENDEDOR
  NEGOCIO
}

enum OrderFulfillmentStatus {
  PENDING
  SHIPPED
  CANCELED
}

model Business {
  id                       String          @id @default(cuid())
  name                     String
  description              String?
  customInstructions       String?
  assistantName            String?
  botTone                  String?
  botDialect               String?
  botGreeting              String?
  botNeverSay              String?
  autoSendPhotoOnQuote     Boolean         @default(true)
  requirePaymentProof      Boolean         @default(true)
  businessCategory         String?
  email                    String          @unique
  passwordHash             String
  planTier                 PlanTier        @default(BASICO)
  active                   Boolean         @default(false)
  contactPhone             String?
  contactName              String?
  passwordResetCode        String?
  passwordResetExpiresAt   DateTime?
  capNotifiedAt            DateTime?
  whatsappPhoneNumberId    String?         @unique
  whatsappBusinessAccountId String?
  whatsappPhoneNumber      String?
  whatsappAccessToken      String?
  followUpTemplateName     String?
  followUpTemplateLanguage String          @default("es")
  followUpDelayHours       Int             @default(24)
  ownerReminderMinutes     Int             @default(180)
  products                 Product[]
  customers                Customer[]
  paymentMethods           PaymentMethod[]
  shippingRates            ShippingRate[]
  shippingCityRules        ShippingCityRule[]
  aiUsageLogs              AiUsageLog[]
  faqEntries               FaqEntry[]
  learnedFaqCandidates     LearnedFaqCandidate[]
  deliveryFailures         DeliveryFailure[]
  ownerMessageLogs         OwnerMessageLog[]
  orders                   Order[]
  teamMembers              TeamMember[]
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
}

enum PaymentMethodType {
  TRANSFERENCIA
  TARJETA
  EFECTIVO
}

model PaymentMethod {
  id         String            @id @default(cuid())
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  type       PaymentMethodType
  label      String
  details    String
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
}

// A structured price per shipping tier (city/zone label -> real cost), so the agent has a real number to
// fetch instead of only the free-text tier table a business writes into its own customInstructions -
// mirrors PaymentMethod's role for payment data. Optional: a business with no rows here just isn't
// affected, its customInstructions prose keeps working exactly as before.
model ShippingRate {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  label      String
  cost       Decimal  @db.Decimal(12, 2)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([businessId])
}

// A literal, exact city-name -> ShippingRate.label mapping. Deliberately NOT a full city taxonomy: this
// only structurally solves the enumerable case (a business typing "Bogota"/"Soacha" as an exact rule) -
// abstract regional tiers (e.g. "principales ciudades de Colombia") stay pure model judgment via
// customInstructions, exactly as today. `label` is a plain string reference to ShippingRate.label,
// resolved at READ time rather than a relation/FK to ShippingRate.id: if that ShippingRate row is later
// renamed or deleted, this row does NOT become an invalid FK - it just silently stops resolving to a real
// cost, treated identically to "no rule configured" instead of crashing. `city` keeps the original
// as-typed text for any future admin UI; `normalizedCity` (lowercase, accent-stripped via
// normalizeForMatch) is the actual match key, so "Bogota" and "Bogotá" both resolve to the same rule.
model ShippingCityRule {
  id             String   @id @default(cuid())
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String
  city           String
  normalizedCity String
  label          String
  createdAt      DateTime @default(now())

  @@unique([businessId, normalizedCity])
  @@index([businessId])
}

model Order {
  id                 String       @id @default(cuid())
  business           Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId         String
  customer           Customer     @relation(fields: [customerId], references: [id])
  customerId         String
  conversation       Conversation @relation(fields: [conversationId], references: [id])
  conversationId     String       @unique
  summary            String
  shippingAddress    String?
  paymentMethodLabel String?
  shippingCost       Decimal?     @db.Decimal(12, 2)
  totalAmount        Decimal      @db.Decimal(12, 2)
  currency           String
  csatRating         Int?
  csatAskedAt        DateTime?
  fulfillmentStatus  OrderFulfillmentStatus @default(PENDING)
  shippedAt          DateTime?
  shipmentNote       String?
  shipmentMediaS3Key String?
  shipmentMediaType  String?
  canceledAt         DateTime?
  items              OrderItem[]
  createdAt          DateTime     @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, fulfillmentStatus])
}

model OrderItem {
  id          String  @id @default(cuid())
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  productId   String?
  productName String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  currency    String
}

enum TeamRole {
  EMPLOYEE
}

model TeamMember {
  id           String   @id @default(cuid())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId   String
  email        String   @unique
  passwordHash String
  name         String
  role         TeamRole @default(EMPLOYEE)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model FaqEntry {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  question   String
  answer     String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

enum LearnedFaqCandidateStatus {
  PENDING
  APPROVED
  DISCARDED
}

// A {question, answer} pair captured from a resolved ask_owner exchange - the owner already answered
// a customer's question once for real, this surfaces it as a suggested FaqEntry instead of discarding
// it after that one use. Never auto-published: stays PENDING until the owner approves it (possibly
// editing the wording first) from the admin panel. `occurrences` tracks how many times a
// near-duplicate question showed up before being reviewed, as a demand signal.
model LearnedFaqCandidate {
  id             String                    @id @default(cuid())
  business       Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String
  question       String
  answer         String
  conversationId String?
  occurrences    Int                       @default(1)
  status         LearnedFaqCandidateStatus @default(PENDING)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([businessId, status])
}

// Meta's delivery-status webhook reports failures asynchronously, after the send call already
// returned a wamid looking successful (src/routes/whatsapp.ts) - previously that only hit
// console.error, invisible unless someone went looking in the droplet's pm2 logs over SSH. This
// persists it so the admin panel can surface it live. `critical` marks a failure to reach the
// business owner specifically (recipient matches Business.contactPhone) - that's the dangerous case,
// since it usually means an ask_owner escalation the owner never saw.
model DeliveryFailure {
  id             String   @id @default(cuid())
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String
  wamid          String
  recipientPhone String
  errorCode      Int?
  errorMessage   String
  critical       Boolean  @default(false)
  resolved       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([businessId, resolved])
}

// Chat-style transcript of everything the bot sends to the business owner (alerts, sale
// confirmations, ask_owner escalations) and every reply the owner sends back - this is the only
// place the admin panel can show "did the owner actually get this" as a conversation instead of
// scattered pm2 log lines. `success: false` covers both a synchronous API error (template not
// approved, etc.) and the final fallback failing too - see recordOwnerMessage in
// src/delivery/ownerLog.ts.
model OwnerMessageLog {
  id           String                @id @default(cuid())
  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId   String
  direction    OwnerMessageDirection
  body         String
  success      Boolean               @default(true)
  errorMessage String?
  createdAt    DateTime              @default(now())

  @@index([businessId, createdAt])
}

enum OwnerMessageDirection {
  OUT
  IN
}

model KeyRequest {
  id           String   @id @default(cuid())
  businessName String
  email        String
  phone        String
  planTier     PlanTier
  handled      Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model ActivationKey {
  id               String    @id @default(cuid())
  code             String    @unique
  planTier         PlanTier
  used             Boolean   @default(false)
  usedByBusinessId String?   @unique
  createdAt        DateTime  @default(now())
  usedAt           DateTime?
}

model Product {
  id           String         @id @default(cuid())
  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId   String
  name         String
  description  String
  price        Decimal        @db.Decimal(12, 2)
  currency     String         @default("USD")
  stock        Int            @default(0)
  category     String?
  active       Boolean        @default(true)
  inquiryCount Int            @default(0)
  media        ProductMedia[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model ProductMedia {
  id        String    @id @default(cuid())
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  type      MediaType
  url       String
  s3Key     String
  createdAt DateTime  @default(now())
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

model Customer {
  id            String         @id @default(cuid())
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String
  phoneNumber   String
  name          String?
  idNumber      String?
  deliveryPhone String?
  tags          String[]       @default([])
  conversations Conversation[]
  orders        Order[]
  createdAt     DateTime       @default(now())

  @@unique([businessId, phoneNumber])
}

model Conversation {
  id                           String              @id @default(cuid())
  customer                     Customer            @relation(fields: [customerId], references: [id])
  customerId                   String
  status                       ConversationStatus  @default(NEW)
  intent                       ConversationIntent?
  humanControl                 Boolean             @default(false)
  humanControlAckSent          Boolean             @default(false)
  followUpSentAt               DateTime?
  pendingConfirmationMessageId String?             @unique
  pendingOrderSummary          String?
  pendingOrderItems            Json?
  pendingOwnerQuestions        PendingOwnerQuestion[]
  contextSummary                String?
  contextSummarizedUpTo         Int?
  mediaSentProductIds            String[]            @default([])
  unreadCount                  Int                 @default(0)
  order                        Order?
  messages                     Message[]
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
}

// One row per question escalated to the owner, instead of a single field on Conversation - a customer
// asking several distinct questions before the owner replies to the first one used to overwrite that
// single field each time, so her reply to an earlier question could never be matched back once a later
// question replaced it. Each escalation now gets its own trackable row, matched by the wamid of the
// alert the owner actually replies to.
model PendingOwnerQuestion {
  id             String                   @id @default(cuid())
  conversation   Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  wamid          String                   @unique
  question       String
  kind           PendingOwnerQuestionKind @default(TEXT)
  createdAt      DateTime                 @default(now())
  remindedAt     DateTime?

  @@index([conversationId])
}

// PHOTO_PRODUCT: the owner was sent the customer's actual photo/video to identify (ask_owner_about_photo
// in src/ai/tools.ts), not a plain text question - handleOwnerReply answers it differently (tries to
// resolve the owner's reply to a real catalog product and send its photo back, instead of forwarding the
// owner's raw text as-is).
enum PendingOwnerQuestionKind {
  TEXT
  PHOTO_PRODUCT
}

enum ConversationStatus {
  NEW
  INTERESTED
  QUOTED
  NEGOTIATING
  SOLD
  LOST
}

enum ConversationIntent {
  PQR
  DEVOLUCION
  NO_RECIBIDO
  SOLICITA_AGENTE
}

model Message {
  id                String       @id @default(cuid())
  conversation      Conversation @relation(fields: [conversationId], references: [id])
  conversationId    String
  role              MessageRole
  content           String
  mediaS3Key        String?
  mediaType         MediaType?
  imageAnalysis     String?
  whatsappMessageId String?      @unique
  relatedProductId  String?
  createdAt         DateTime     @default(now())
}

enum MessageRole {
  CUSTOMER
  ASSISTANT
  SYSTEM
}

enum AiUsageKind {
  CHAT
  VISION
  VISION_ESCALATION
}

model AiUsageLog {
  id              String      @id @default(cuid())
  business        Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId      String
  conversationId  String?
  kind            AiUsageKind
  model           String
  cacheHitTokens  Int         @default(0)
  cacheMissTokens Int         @default(0)
  outputTokens    Int         @default(0)
  costUsd         Float
  createdAt       DateTime    @default(now())

  @@index([businessId, createdAt])
}
