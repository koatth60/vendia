generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanTier {
  BASICO
  EMPRENDEDOR
  NEGOCIO
}

model Business {
  id                       String          @id @default(cuid())
  name                     String
  description              String?
  customInstructions       String?
  assistantName            String?
  botTone                  String?
  botDialect               String?
  botGreeting              String?
  botNeverSay              String?
  autoSendPhotoOnQuote     Boolean         @default(true)
  businessCategory         String?
  email                    String          @unique
  passwordHash             String
  planTier                 PlanTier        @default(BASICO)
  active                   Boolean         @default(false)
  contactPhone             String?
  contactName              String?
  passwordResetCode        String?
  passwordResetExpiresAt   DateTime?
  whatsappPhoneNumberId    String?         @unique
  whatsappPhoneNumber      String?
  whatsappAccessToken      String?
  followUpTemplateName     String?
  followUpTemplateLanguage String          @default("es")
  followUpDelayHours       Int             @default(24)
  products                 Product[]
  customers                Customer[]
  paymentMethods           PaymentMethod[]
  aiUsageLogs              AiUsageLog[]
  faqEntries               FaqEntry[]
  orders                   Order[]
  teamMembers              TeamMember[]
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
}

enum PaymentMethodType {
  TRANSFERENCIA
  TARJETA
  EFECTIVO
}

model PaymentMethod {
  id         String            @id @default(cuid())
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  type       PaymentMethodType
  label      String
  details    String
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
}

model Order {
  id                 String       @id @default(cuid())
  business           Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId         String
  customer           Customer     @relation(fields: [customerId], references: [id])
  customerId         String
  conversation       Conversation @relation(fields: [conversationId], references: [id])
  conversationId     String       @unique
  summary            String
  shippingAddress    String?
  paymentMethodLabel String?
  totalAmount        Decimal      @db.Decimal(12, 2)
  currency           String
  items              OrderItem[]
  createdAt          DateTime     @default(now())

  @@index([businessId, createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  productId   String?
  productName String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  currency    String
}

enum TeamRole {
  EMPLOYEE
}

model TeamMember {
  id           String   @id @default(cuid())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId   String
  email        String   @unique
  passwordHash String
  name         String
  role         TeamRole @default(EMPLOYEE)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model FaqEntry {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  question   String
  answer     String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model KeyRequest {
  id           String   @id @default(cuid())
  businessName String
  email        String
  phone        String
  planTier     PlanTier
  handled      Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model ActivationKey {
  id               String    @id @default(cuid())
  code             String    @unique
  planTier         PlanTier
  used             Boolean   @default(false)
  usedByBusinessId String?   @unique
  createdAt        DateTime  @default(now())
  usedAt           DateTime?
}

model Product {
  id           String         @id @default(cuid())
  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId   String
  name         String
  description  String
  price        Decimal        @db.Decimal(12, 2)
  currency     String         @default("USD")
  stock        Int            @default(0)
  category     String?
  active       Boolean        @default(true)
  inquiryCount Int            @default(0)
  media        ProductMedia[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model ProductMedia {
  id        String    @id @default(cuid())
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  type      MediaType
  url       String
  s3Key     String
  createdAt DateTime  @default(now())
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

model Customer {
  id            String         @id @default(cuid())
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String
  phoneNumber   String
  name          String?
  tags          String[]       @default([])
  conversations Conversation[]
  orders        Order[]
  createdAt     DateTime       @default(now())

  @@unique([businessId, phoneNumber])
}

model Conversation {
  id                           String              @id @default(cuid())
  customer                     Customer            @relation(fields: [customerId], references: [id])
  customerId                   String
  status                       ConversationStatus  @default(NEW)
  intent                       ConversationIntent?
  humanControl                 Boolean             @default(false)
  followUpSentAt               DateTime?
  pendingConfirmationMessageId String?             @unique
  pendingOrderSummary          String?
  pendingOrderItems            Json?
  pendingOwnerQuestionMessageId String?            @unique
  order                        Order?
  messages                     Message[]
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
}

enum ConversationStatus {
  NEW
  INTERESTED
  QUOTED
  NEGOTIATING
  SOLD
  LOST
}

enum ConversationIntent {
  PQR
  DEVOLUCION
  NO_RECIBIDO
}

model Message {
  id                String       @id @default(cuid())
  conversation      Conversation @relation(fields: [conversationId], references: [id])
  conversationId    String
  role              MessageRole
  content           String
  mediaS3Key        String?
  mediaType         MediaType?
  imageAnalysis     String?
  whatsappMessageId String?      @unique
  createdAt         DateTime     @default(now())
}

enum MessageRole {
  CUSTOMER
  ASSISTANT
  SYSTEM
}

enum AiUsageKind {
  CHAT
  VISION
}

model AiUsageLog {
  id              String      @id @default(cuid())
  business        Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId      String
  conversationId  String?
  kind            AiUsageKind
  model           String
  cacheHitTokens  Int         @default(0)
  cacheMissTokens Int         @default(0)
  outputTokens    Int         @default(0)
  costUsd         Float
  createdAt       DateTime    @default(now())

  @@index([businessId, createdAt])
}
