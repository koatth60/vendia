generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanTier {
  BASICO
  EMPRENDEDOR
  NEGOCIO
}

// E31 (2026-09-18). Estados reales del pedido.
//
// PENDING es el valor HISTORICO y se conserva: es el que tienen todos los pedidos ya creados, y
// borrarlo de un enum de Postgres obligaria a reescribir filas. La maquina de estados
// (src/orders/stateMachine.ts) lo trata como sinonimo de PENDING_PAYMENT, que es como se llama el
// mismo estado de ahora en adelante. Migracion aditiva: ninguna fila existente se toca.
enum OrderFulfillmentStatus {
  PENDING
  PENDING_PAYMENT
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELED
  RETURNED
  REFUNDED
}

// Quien movio el pedido y de donde a donde. Hasta el 2026-09-18 no habia NINGUN campo que registrara
// quien envio o quien cancelo: el pedido cambiaba de estado y no quedaba rastro de por que ni de mano
// de quien. Un pedido cancelado y un cliente reclamando eran dos hechos sin forma de cruzarlos.
// E35: si el pedido esta pagado, a medias, o si se devolvio la plata. Es distinto de
// `fulfillmentStatus` (donde esta la mercaderia) y de `amountOnDelivery` (cuanto falta cobrar al
// entregar): un pedido puede estar SHIPPED y sin pagar, o PAID y todavia en el deposito.
/// Hasta que punto puede CANCELAR EL BOT un pedido, sin que el dueno tenga que hacer nada.
///
/// La tabla de transiciones sigue mandando sobre lo que es posible; esto solo dice hasta donde llega el
/// bot solo. El dueno, desde el panel, no pierde ninguna capacidad.
enum CancelacionPorElBot {
  /// El bot no cancela nunca. Escala y decide el dueno.
  NUNCA
  /// Hasta antes de que el pedido salga. Es lo que hacia el sistema antes de que esto fuera configurable.
  ANTES_DE_DESPACHAR
  /// Tambien con el pedido ya despachado, mientras no se haya entregado.
  ANTES_DE_ENTREGAR
}

enum OrderPaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum OrderEventActor {
  OWNER
  EMPLOYEE
  AGENT
  JOB
  SYSTEM
}

model Business {
  id                        String                    @id @default(cuid())
  name                      String
  description               String?
  customInstructions        String?
  assistantName             String?
  botTone                   String?
  botDialect                String?
  botGreeting               String?
  botNeverSay               String?
  autoSendPhotoOnQuote      Boolean                   @default(true)
  // Fase E, 2026-09-13 audit (F8): a third photo mode - list the catalog by text and OFFER photos instead
  // of sending them right away, unless the customer's own message already asked for photos (then send
  // list+photos together). Independent flag rather than a 3rd value of autoSendPhotoOnQuote - keeps that
  // field's existing AUTO/REACTIVE meaning untouched for every business that hasn't opted into this.
  offerPhotosBeforeSending  Boolean                   @default(false)
  requirePaymentProof       Boolean                   @default(true)
  /// Hasta donde puede cancelar el bot sin intervencion del dueno. Por defecto, lo de siempre.
  cancelacionPorElBot       CancelacionPorElBot       @default(ANTES_DE_DESPACHAR)
  businessCategory          String?
  email                     String                    @unique
  passwordHash              String
  planTier                  PlanTier                  @default(BASICO)
  active                    Boolean                   @default(false)
  contactPhone              String?
  contactName               String?
  passwordResetCode         String?
  passwordResetExpiresAt    DateTime?
  capNotifiedAt             DateTime?
  // EL FRENO DE GASTO (2026-09-17). Desde que pasar el tope de chats factura en vez de apagar el bot
  // (ver BillableChat), nada limitaba cuanto podia gastar un negocio en IA: un pico raro o un bucle
  // llamaba al modelo sin techo y lo pagabamos nosotros.
  //
  // Es el costo de IA en USD del mes corriente, sumado de AiUsageLog. NO es un tope comercial - el
  // cliente compro sus chats y se los damos. Es un cortacircuitos para un gasto anomalo, y por eso el
  // numero lo pone Zaqi desde el panel de plataforma y no el dueno del negocio desde el suyo.
  //
  // null = usar el default que sale del plan (ver defaultCeilingUsd en src/billing/spendCeiling.ts).
  // Asi ningun negocio queda sin freno por olvido, que es justo como se llego hasta aca.
  aiSpendCeilingUsd         Float?
  spendCeilingNotifiedAt    DateTime?
  whatsappPhoneNumberId     String?                   @unique
  whatsappBusinessAccountId String?
  whatsappPhoneNumber       String?
  whatsappAccessToken       String?
  // Fase 7 del plan maestro (2026-09-15): los tokens de Embedded Signup expiran a los 60 dias (ver
  // whatsapp/embeddedSignup.ts) y hasta ahora nada guardaba esa fecha ni avisaba. whatsappConnect.ts
  // la setea al conectar; jobs/tokenExpiry.ts avisa al dueno y a Zaqi 7 dias antes y limpia
  // whatsappTokenExpiryNotifiedAt en cada reconexion para que la proxima expiracion vuelva a avisar.
  whatsappTokenExpiresAt        DateTime?
  whatsappTokenExpiryNotifiedAt DateTime?
  // E30 (2026-09-18): el texto cifrado de whatsappAccessToken no se pudo descifrar al leerlo. El token
  // queda en null y ESTA fila queda marcada, porque un token null tambien lo tiene un negocio que nunca
  // conecto WhatsApp: sin la marca, "roto" y "nunca conectado" se ven identicos en el panel y el dueño
  // no sabe que tiene que reconectar. La escribe la extension de lectura de src/db/client.ts.
  secretsBroken                 Boolean   @default(false)
  // E28 (2026-09-18): sube de a uno cada vez que hay que invalidar TODAS las sesiones vivas de este
  // negocio. requireAuth compara la version guardada en la cookie contra esta; si no coinciden, la
  // sesion se destruye. Sin esto, quitarle el acceso a alguien no surtia efecto hasta que su cookie
  // expirara sola.
  sessionVersion                Int       @default(0)
  // Error 190 de Meta (token vencido o revocado) marca la conexion como caida - src/whatsapp/outbound.ts
  // la setea al clasificar ese error, whatsappConnect.ts la limpia al reconectar. Distinto de un token
  // que todavia no vencio pero que Meta igual rechazo (revocado a mano, WABA desconectada).
  whatsappConnectionBrokenAt    DateTime?
  followUpTemplateName      String?
  followUpTemplateLanguage  String                    @default("es")
  followUpDelayHours        Int                       @default(24)
  ownerReminderMinutes      Int                       @default(180)
  // Correccion Fase 4 del plan maestro (2026-09-15), causa raiz C2: blockedBy (ver saleState.ts) no
  // tenia salida si el dueno nunca respondia una pregunta escalada - la conversacion quedaba muda para
  // siempre. Pasadas estas horas sin respuesta, jobs/escalationReminder.ts limpia blockedBy, pasa la
  // conversacion a control humano y avisa al dueno y al panel. Configurable por negocio, igual que
  // ownerReminderMinutes arriba.
  ownerQuestionTimeoutHours Int                       @default(24)
  // Fase 9 del plan maestro (2026-09-15): flag_conversation_intent (PQR/devolucion/no_recibido/pide
  // agente) deja el bot mudo (humanControl=true) hasta que el dueno responda, sin salida si nunca lo hace
  // - un intent que el MODELO dedujo mal (ver Conversation.intentExplicit) deja al cliente sin respuesta
  // para siempre y sin forma de volver salvo que alguien entre al panel. Mismo patron de escape que
  // ownerQuestionTimeoutHours arriba: pasadas estas horas sin que humanControlSince se refresque (el
  // dueno nunca respondio desde el panel), jobs/escalationReminder.ts devuelve el control al bot solo.
  // Default mas largo que ownerQuestionTimeoutHours porque aca no hay una pregunta puntual bloqueando el
  // checkout, es la conversacion entera, y el stage-2 del watchdog de estancadas ya avisa a las 24h.
  intentEscalationTimeoutHours Int                     @default(48)
  // Fase 9: umbral de inactividad del CLIENTE (no del dueno) antes de que la conversacion pase a
  // ABANDONED - ver jobs/abandonment.ts. Configurable porque un negocio de ticket alto puede querer un
  // umbral mas largo que uno de compra impulsiva.
  abandonedAfterHours       Int                       @default(72)
  // Fase 9: plantilla aprobada para recuperar un carrito (SaleState con items) cuando su conversacion
  // pasa a ABANDONED - distinta de followUpTemplateName (esa es post-venta, esta es pre-venta). Vacio =
  // desactivado, mismo patron que followUpTemplateName.
  cartRecoveryTemplateName     String?
  cartRecoveryTemplateLanguage String                 @default("es")
  // Gendered address tone (ej: alternar el nombre con "linda"/"bella" para mujeres, "Sr."/"Señor" para
  // hombres) - encontrado en el prompt de MAGByLizN, promovido a mecanismo core (detectar genero,
  // corregir si el cliente se queja) pero las palabras exactas quedan opt-in por negocio: off por
  // defecto, otro negocio puede no querer ese trato.
  genderedAddressEnabled    Boolean                   @default(false)
  femaleAddressTerm         String?
  maleAddressTerm           String?
  // Que modalidades de pago de ENVIO ofrece este negocio (distinto del canal de pago - Nequi/tarjeta/etc,
  // ver PaymentMethod arriba). Vacio = el negocio no usa este concepto, el flujo de pago generico sigue
  // igual que siempre. Encontrado en el prompt de MAGByLizN (pagar todo anticipado / solo producto
  // anticipado+envio contraentrega / todo contraentrega), promovido a mecanismo core reusable.
  shippingPaymentModalities ShippingPaymentModality[] @default([])
  // Fase 2 del plan maestro (2026-09-15): motor de venta ejecutable (SaleState) contra el modelo
  // leyendo/escribiendo el estado por su cuenta. Off por defecto - bandera de reversion explicita del
  // plan: un negocio se prueba primero con esto en true, el resto sigue exactamente igual que hoy.
  saleStateEnabled         Boolean                   @default(false)
  // Efectos requeridos (2026-09-15): antes de enviar la respuesta, el motor verifica contra la base que
  // el turno haya producido el efecto que su propio texto dice haber producido, y si falta lo reintenta,
  // lo ejecuta desde el codigo o escala. Ver src/ai/requiredEffects.ts.
  //
  // Nacio off, para encenderlo en un negocio a la vez. 2026-09-17: dejo de ser una opcion del panel y paso a default true. Que el bot compruebe contra la
  // base que el pedido quedo registrado y que el dueno se entero no es una preferencia de negocio - es
  // parte de estar bien hecho, y nadie que compra un bot de ventas quiere la version que no verifica.
  // Medido en MAGByLizN sobre 7 dias con la bandera encendida: cero escalaciones a control humano por
  // este mecanismo y cero incidentes con su guard.
  //
  // La columna sobrevive, pero como freno de OPERACION y no como casilla: si alguna vez hay que apagarlo
  // en un negocio para diagnosticar, se hace por SQL, a mano y a sabiendas.
  requiredEffectsEnabled    Boolean                   @default(true)
  // Listas interactivas de WhatsApp (2026-09-17): cuando el servidor presenta una categoria, la manda
  // como lista tocable en vez de texto numerado, y la eleccion vuelve como el id del producto. Elegir
  // deja de pasar por la prosa - es lo unico que hace imposible que "el numero 6" resuelva a un producto
  // que tiene un 6 en el nombre.
  //
  // Off por defecto y con su interruptor en el panel: cambia la FORMA de un mensaje que ve el cliente, y
  // eso no se puede validar sin una conversacion real. Apagada, sale el texto numerado de siempre.
  interactiveListsEnabled   Boolean                   @default(false)
  // E11 (2026-09-18). Compara contra el catalogo los COLORES que escribe el agente, no solo los precios
  // y los nombres. Apagada por defecto y encendida negocio por negocio a proposito: un color legitimo
  // marcado por error le llega al cliente, asi que primero se mide la tasa de falsos positivos en modo
  // sombra (AgentTurn.shadowFindings la registra siempre, este campo solo decide si ADEMAS bloquea).
  attributeCheckEnabled     Boolean                   @default(false)
  // HASTA DONDE LLEGAN LAS FOTOS (2026-09-17). Lo elige el dueno en el panel, y es la unica cosa que lo
  // decide: ni el modelo ni una lectura del mensaje del cliente.
  //
  //   PRODUCT  - fotos solo en la ficha de UN producto. Es lo que hacia el sistema hasta hoy, y por eso
  //              es el default: ningun negocio existente cambia de conducta al agregarse este campo.
  //   CATEGORY - ademas, pedir una categoria manda la lista numerada y una foto de cada producto de esa
  //              categoria, con el pie que dice cual es cual.
  //   CATALOG  - ademas, lo mismo para el catalogo completo: un mensaje por categoria con sus fotos.
  //
  // Un solo campo con tres valores en vez de tres booleanos: los niveles se contienen, y dos
  // interruptores independientes admitirian estados sin significado ("catalogo si, categoria no").
  catalogPhotoScope         CatalogPhotoScope         @default(PRODUCT)
  // Fase 11 del plan maestro (2026-09-15), causa raiz C5: el pais del negocio deja de estar cableado en
  // el codigo. Elige la entrada de src/config/countries.ts que decide el formato de precio, que forma
  // tiene un telefono y un documento, como se reconoce una direccion despachable y como se le pide cada
  // dato al cliente. Default "CO" porque es lo que todo negocio existente ya era.
  countryCode               String                    @default("CO")
  // Moneda y zona horaria arrancan del pais (ver countries.ts) pero son campos propios: un negocio
  // colombiano que cobra en USD, o uno mexicano en Cancun, existe y no deberia necesitar un pais nuevo.
  currency                  String                    @default("COP")
  timezone                  String                    @default("America/Bogota")
  // Horario de atencion, forma { "mon": ["09:00","18:00"], ..., "sun": null } - ver
  // src/config/businessHours.ts. null = sin cargar, y entonces nada entra al prompt.
  businessHours             Json?
  // Si este negocio pide documento de identidad para despachar. Antes era una constante de Colombia.
  requiresIdDocument        Boolean                   @default(true)
  // Zonas de envio (ShippingRate.label, comparado sin tildes ni mayusculas) donde el documento NO se
  // pide. Antes era la lista literal ["bogota","soacha"] adentro de orders/checkoutState.ts, igual para
  // todos los negocios del producto. La migracion la copia tal cual a los negocios que ya existian.
  idDocumentExemptZones     String[]                  @default([])
  products                  Product[]
  promotions                Promotion[]
  bundles                   Bundle[]
  customers                 Customer[]
  paymentMethods            PaymentMethod[]
  shippingRates             ShippingRate[]
  shippingCityRules         ShippingCityRule[]
  categoryAliases           CategoryAlias[]
  aiUsageLogs               AiUsageLog[]
  billableChats             BillableChat[]
  faqEntries                FaqEntry[]
  learnedFaqCandidates      LearnedFaqCandidate[]
  deliveryFailures          DeliveryFailure[]
  agentIncidents            AgentIncident[]
  agentTurns                AgentTurn[]
  customerNotes             CustomerNote[]
  customerTags              CustomerTag[]
  ownerMessageLogs          OwnerMessageLog[]
  orders                    Order[]
  teamMembers               TeamMember[]
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
}

// Ver Business.catalogPhotoScope. Los tres valores son niveles que se contienen: CATALOG incluye lo de
// CATEGORY, y CATEGORY incluye lo de PRODUCT.
enum CatalogPhotoScope {
  PRODUCT
  CATEGORY
  CATALOG
}

enum PaymentMethodType {
  TRANSFERENCIA
  TARJETA
  EFECTIVO
}

// Who pays for shipping and when - a different axis than PaymentMethodType (which channel: Nequi, card,
// cash). A business can offer any subset (see Business.shippingPaymentModalities); most businesses won't
// use this concept at all and leave it empty.
enum ShippingPaymentModality {
  PREPAID_ALL // paga producto + envio, todo por adelantado
  PREPAID_PRODUCT_COD_SHIPPING // paga el producto por adelantado, el envio se paga contraentrega
  COD_ALL // paga todo (producto + envio) contraentrega
}

// CUANDO entra la plata, que es un eje distinto de PaymentMethodType (por que canal) y de
// ShippingPaymentModality (quien paga el envio). Es lo unico que decide si hay algo que verificar antes
// de despachar: con PREPAID el dueno es la unica persona que puede confirmar que el pago llego, con
// ON_DELIVERY no hay nada que confirmar porque la plata se cobra al entregar.
//
// Defecto real (2026-09-17): close_conversation le pedia confirmacion al dueno SIEMPRE, sin mirar nunca
// como se pagaba. Un pedido contraentrega quedaba esperando un "¿te llego el pago?" por un pago que,
// por definicion, todavia no existe.
// Quien (o que) dejo una conversacion en manos de una persona. Los cuatro PANEL_* los dispara el dueno
// desde el panel; los demas ocurren sin que nadie toque nada.
enum HumanControlReason {
  PANEL_TOGGLE // apreto el boton de tomar el control
  PANEL_MESSAGE // escribio un mensaje desde el panel
  PANEL_TEMPLATE // mando una plantilla desde el panel
  PANEL_QUEUE // dejo un mensaje encolado con la ventana de 24h cerrada
  INTENT_ESCALATION // flag_conversation_intent: PQR, devolucion, no recibido, pide asesor
  PHOTO_ESCALATION // ask_owner_about_photo: no se pudo identificar el producto de una foto
  OWNER_QUESTION_TIMEOUT // el dueno nunca contesto una pregunta escalada
  SALE_CONFIRMATION_TIMEOUT // el dueno nunca confirmo un pago
  STALE_REPLY // la respuesta tardo demasiado y se descarto
  REQUIRED_EFFECT // un efecto requerido no se cumplio ni con reintento ni con el respaldo por codigo
}

enum PaymentSettlement {
  PREPAID // la plata tiene que entrar ANTES de despachar (transferencia, tarjeta, anticipado)
  ON_DELIVERY // la plata se cobra al entregar (contraentrega)
}

model PaymentMethod {
  id         String            @id @default(cuid())
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  type       PaymentMethodType
  label      String
  details    String
  active     Boolean           @default(true)
  // PREPAID por defecto a proposito: es el comportamiento que ya existia (siempre confirmar). Un negocio
  // que marca su metodo contraentrega como ON_DELIVERY deja de recibir preguntas que no puede contestar.
  settlement PaymentSettlement @default(PREPAID)
  createdAt  DateTime          @default(now())
}

// A structured price per shipping tier (city/zone label -> real cost), so the agent has a real number to
// fetch instead of only the free-text tier table a business writes into its own customInstructions -
// mirrors PaymentMethod's role for payment data. Optional: a business with no rows here just isn't
// affected, its customInstructions prose keeps working exactly as before.
model ShippingRate {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  label      String
  cost       Decimal  @db.Decimal(12, 2)
  sortOrder  Int      @default(0)
  // Que modalidades de pago del envio aplican EN ESTA ZONA (2026-09-17). Vacio = las del negocio
  // (Business.shippingPaymentModalities), que es el comportamiento anterior a este campo.
  //
  // Existe porque la contraentrega casi nunca es una politica del negocio entero: es una politica por
  // zona. MAG.IMP la tenia escrita como prosa en sus instrucciones ("si la ciudad es Bogota o Soacha,
  // ofrece ademas Pago Contra Entrega Total"), o sea como una regla que el modelo tenia que recordar
  // entre otras 89 lineas. Aca es un dato, sale con la tarifa en la misma llamada que ya resuelve la
  // ciudad, y se responde con un SELECT.
  paymentModalities ShippingPaymentModality[] @default([])
  // CUANDO SALE Y CUANDO LLEGA UN PEDIDO DE ESTA ZONA (2026-09-17, etapa E05 de ONIX-PLAN.md).
  //
  // Todas nullable o con valor por defecto: una tarifa sin nada de esto cargado no promete ninguna
  // fecha, que es exactamente el comportamiento anterior a estas columnas.
  //
  // Existen porque MAG.IMP tenia sus plazos escritos como prosa RELATIVA AL RELOJ ("si compra antes de
  // las 11:00 AM puede llegar el mismo dia; si es despues, llega al dia siguiente", "los domingos no se
  // pueden hacer envios"), o sea tres reglas que el modelo tenia que evaluar a mano en cada turno. El
  // 2026-09-17 no acerto: dijo "manana se realiza el despacho" a las 10:33 de un jueves, cuando el
  // despacho era ese mismo dia. Aca son datos y el servidor calcula la fecha con un SELECT y aritmetica.
  /** "HH:MM" en hora local del negocio. Antes de esa hora el pedido alcanza el despacho del dia. */
  cutoffTime String?
  /** true = comprando antes del corte, sale HOY. false = sale el proximo dia de despacho. */
  sameDayBeforeCutoff Boolean @default(false)
  /** Dias habiles de transito despues del despacho, minimo y maximo. */
  deliveryDaysMin Int?
  deliveryDaysMax Int?
  /** Dias de la semana en que este negocio NO despacha. 0 = domingo, 6 = sabado. */
  noDispatchWeekdays Int[] @default([])
  createdAt  DateTime @default(now())

  @@index([businessId])
}

// A literal, exact city-name -> ShippingRate.label mapping. Deliberately NOT a full city taxonomy: this
// only structurally solves the enumerable case (a business typing "Bogota"/"Soacha" as an exact rule) -
// abstract regional tiers (e.g. "principales ciudades de Colombia") stay pure model judgment via
// customInstructions, exactly as today. `label` is a plain string reference to ShippingRate.label,
// resolved at READ time rather than a relation/FK to ShippingRate.id: if that ShippingRate row is later
// renamed or deleted, this row does NOT become an invalid FK - it just silently stops resolving to a real
// cost, treated identically to "no rule configured" instead of crashing. `city` keeps the original
// as-typed text for any future admin UI; `normalizedCity` (lowercase, accent-stripped via
// normalizeForMatch) is the actual match key, so "Bogota" and "Bogotá" both resolve to the same rule.
model ShippingCityRule {
  id             String   @id @default(cuid())
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String
  city           String
  normalizedCity String
  label          String
  // Cuando paga el cliente EN ESTA CIUDAD. Vacio = lo que diga su tarifa (ShippingRate.paymentModalities),
  // y si esa tampoco tiene, lo del negocio.
  //
  // Existe porque aceptar que paguen todo al recibir es una decision de LUGAR, no de precio: depende de
  // si el negocio llega ahi con su propio mensajero. Las tarifas agrupan por costo - "Nacional" junta
  // Medellin con cien ciudades mas - asi que sin esto un negocio que quiere contraentrega total en
  // Medellin y Bucaramanga y en ninguna otra ciudad de esa tarifa tendria que inventarse tarifas
  // duplicadas para separarlas. Aca lo marca ciudad por ciudad y no le toca nada a las demas.
  paymentModalities ShippingPaymentModality[] @default([])
  createdAt      DateTime @default(now())

  @@unique([businessId, normalizedCity])
  @@index([businessId])
}

// Per-business category-word synonyms (e.g. "reloj" = "smartwatch" for a tech reseller, "guineo" =
// "banano" for a fruit stand) - deliberately NOT a fixed dictionary in code (see attributeTaxonomy.ts):
// which words mean the same product type is entirely vertical-specific, so each business configures its
// own. `synonym` is the word that gets folded INTO `canonical` when matching (e.g. synonym="smartwatch",
// canonical="reloj") - a customer/catalog word with no configured alias just matches itself, unchanged
// from before this table existed. `normalizedSynonym` (via normalizeForMatch) is the actual match key.
model CategoryAlias {
  id                String   @id @default(cuid())
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId        String
  canonical         String
  synonym           String
  normalizedSynonym String
  createdAt         DateTime @default(now())

  @@unique([businessId, normalizedSynonym])
  @@index([businessId])
}

model Order {
  id                 String                 @id @default(cuid())
  business           Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId         String
  customer           Customer               @relation(fields: [customerId], references: [id])
  customerId         String
  conversation       Conversation           @relation(fields: [conversationId], references: [id])
  conversationId     String                 @unique
  summary            String
  shippingAddress    String?
  paymentMethodLabel String?
  shippingCost       Decimal?               @db.Decimal(12, 2)
  totalAmount        Decimal                @db.Decimal(12, 2)
  // COMO SE PAGA ESTE PEDIDO (2026-09-17). Hasta hoy el pedido guardaba el total y con que metodo, pero
  // no CUANDO se paga, asi que "¿cuanto le cobro al mensajero?" solo se podia responder releyendo el
  // chat. Es la pregunta que el dueno se hace en cada despacho.
  //
  // `shippingModality` es la que eligio el cliente; null cuando el negocio no usa el concepto o cuando
  // no se pudo resolver sin adivinar. `amountOnDelivery` es lo que hay que cobrar al entregar, en la
  // misma moneda del pedido: 0 si ya esta todo pagado, el envio si solo falta el flete, el total si es
  // contraentrega completa. Null significa "no lo sabemos", que NO es lo mismo que cero - y por eso son
  // dos columnas y no un booleano.
  shippingModality   ShippingPaymentModality?
  amountOnDelivery   Decimal?               @db.Decimal(12, 2)
  currency           String
  csatRating         Int?
  csatAskedAt        DateTime?
  fulfillmentStatus  OrderFulfillmentStatus @default(PENDING)
  shippedAt          DateTime?
  shipmentNote       String?
  shipmentMediaS3Key String?
  shipmentMediaType  String?
  canceledAt         DateTime?

  // E34 (2026-09-18). CANCELAR NUNCA OCURRE EN EL MISMO TURNO EN QUE SE PIDE.
  //
  // Hasta hoy la confirmacion la sostenia una directiva del prompt: "pregunta primero y espera el si en
  // un mensaje aparte". O sea que lo unico que impedia cancelar un pedido de una, por una frase mal
  // leida, era que el modelo se acordara. Ahora la primera llamada a `cancel_order` NO cancela: escribe
  // esta marca y devuelve el pedido para que el agente pregunte. La segunda cancela solo si esta marca
  // es anterior al arranque del turno -- o sea, solo si hubo un mensaje de la clienta en el medio.
  //
  // El fallback no tiene modelo adentro: si nada pasa, el pedido sigue vivo, que es el estado seguro.
  cancelRequestedAt  DateTime?

  // E35 (2026-09-18). EL PEDIDO SABE DONDE ESTA.
  //
  // Medido en produccion el 2026-09-18: 55 mensajes de esta base mencionan guia, rastreo o una
  // transportadora, y 6 clientas preguntan "cuando llega". Ninguno de esos datos existia como dato: la
  // duena los escribia a mano en el chat, uno por uno, y el bot no podia contestar ni el mas simple
  // porque no habia donde leerlo.
  //
  // Son columnas nullable a proposito: null significa "todavia no se sabe", que no es lo mismo que
  // vacio. Un pedido sin guia no es un pedido con guia en blanco.
  /** La transportadora, tal como la nombra el negocio: "Interrapidisimo", "Servientrega", "mensajero propio". */
  carrier            String?
  /** El numero de guia. Es lo que la clienta pega en la pagina de la transportadora. */
  trackingNumber     String?
  /** Cuando se estima la entrega. Solo fecha: la hora no se sabe y prometerla seria inventar. */
  estimatedDelivery  DateTime?

  // EL PAGO, que hasta hoy tampoco era un dato: `paymentMethodLabel` decia COMO iba a pagar, nunca si
  // pago. `amountOnDelivery` dice cuanto falta cobrar al entregar, que es otra pregunta.
  paymentStatus      OrderPaymentStatus     @default(UNPAID)
  /** La referencia del pago: el numero de la transferencia, el id de Nequi, el recibo. */
  paymentReference   String?

  // El impuesto y el descuento del pedido, cuando el negocio los usa. Entran en el total (ver
  // src/orders/service.ts): total = items + envio + impuesto - descuento. Lo que E40 agrega encima es
  // el impuesto CONFIGURADO por negocio, que hoy hay que escribir a mano en cada pedido.
  taxAmount          Decimal?               @db.Decimal(12, 2)
  discountAmount     Decimal?               @db.Decimal(12, 2)

  items              OrderItem[]
  createdAt          DateTime               @default(now())

  events             OrderEvent[]

  @@index([businessId, createdAt])
  @@index([businessId, fulfillmentStatus])
}

// E31: la historia del pedido. Una fila por transicion aceptada.
model OrderEvent {
  id         String                 @id @default(cuid())
  order      Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  businessId String
  from       OrderFulfillmentStatus
  to         OrderFulfillmentStatus
  actor      OrderEventActor
  // Quien fue, cuando se puede saber: el email de la sesion del panel, o el id del job. Null para el
  // agente y para transiciones del sistema.
  actorLabel String?
  reason     String?
  createdAt  DateTime               @default(now())

  @@index([orderId, createdAt])
  @@index([businessId, createdAt])
}

// Fase 2 del plan maestro (2026-09-15), causa raiz C1: hasta ahora ningun lugar del sistema sabia que
// producto elegio el cliente, que variante, y que datos de entrega ya dio MIENTRAS la venta esta en
// curso (ver checkoutStateFromDb.ts:41-46) - solo vivia en la memoria del modelo, de ahi salian las
// repreguntas y los guards que leen prosa para adivinar el estado. Esta tabla es la unica escrita por
// el motor de venta (src/orders/saleState.ts), nunca por el modelo directamente.
//
// Deliberadamente chica: NO guarda missing/subtotal/total/shippingCost ni ciudad/barrio por separado -
// esos se derivan en cada lectura (computeCheckoutState + resolveShippingRateForCity, igual que ya hace
// checkoutStateFromDb.ts) a partir de `items` y `address`, para que nunca puedan desincronizarse de la
// base real. Al cerrar la venta, este estado se vuelca a Order y deja de ser la verdad - Order sigue
// siendo la verdad historica.
model SaleState {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String       @unique
  // [{productId, productName, variantId, variantLabel, quantity, unitPrice, currency}] - mismo shape
  // que ResolvedOrderItem (orders/service.ts), validado contra catalogo en cada set_order_item.
  items          Json         @default("[]")
  // Snapshot de ESTA conversacion/venta, no del perfil del cliente (Customer tiene sus propios campos
  // homonimos) - un mismo cliente puede pedir que un pedido puntual llegue a otra direccion. Si estan
  // vacios, saleState.ts cae al dato de Customer; lo que se escribe aca tambien se duplica a Customer
  // (dual-write) para que la proxima conversacion arranque con el ultimo dato real.
  customerName   String?
  idNumber       String?
  deliveryPhone  String?
  address        String?
  shippingModality ShippingPaymentModality?
  paymentMethodId  String?
  // Reservado para Fase 4 (PENDING_OWNER_QUESTION) y Fase 6 (CONFIG_INCOMPLETE) - String simple, no
  // enum: no le fijamos valores a fases que todavia no se disenaron. Sin uso en esta fase.
  blockedBy      String?
  // Fase 5 del plan maestro (2026-09-15), causa raiz C2: nombres (con variante si aplica) de las fotos/
  // videos que YA se mandaron de verdad en esta conversacion, escrito por tools.ts en el momento del
  // envio real - reemplaza reconstruir esa lista leyendo el historial con MEDIA_CAPTION_PATTERN.
  // Independiente de Business.saleStateEnabled, igual que blockedBy: no mandar fotos repetidas no es una
  // funcion del motor de venta.
  mediaSent      String[]     @default([])
  // Ciudad para la que get_shipping_rate_for_city encontro una tarifa real en esta conversacion,
  // escrita por el servidor en el momento del match. Deliberadamente NO entra en el calculo de
  // getSaleState (ciudad/costo se siguen derivando de `address`): es evidencia de lo que el servidor
  // sabe, no un dato de entrega. Independiente de Business.saleStateEnabled, igual que mediaSent.
  shippingCity   String?
  // Cuantas veces seguidas el cliente mando una foto/video para identificar un producto sin que el turno
  // lo resolviera (ni un envio real ni una escalacion al dueno) - ver shouldForcePhotoEscalation en
  // agent.ts. Se resetea a 0 apenas se resuelve; nunca se lee de texto.
  photoIdStreak  Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// EL PRECIO ACORDADO (2026-09-16). Un precio que la duena autorizo para ESTE cliente y estos productos,
// distinto del de catalogo. Antes de esta tabla un descuento vivia unicamente como texto en el chat: el
// agente no lo tenia como dato y cobraba lo unico que tenia, el catalogo (caso real, conversacion
// cmu4gykpm003le82keve7ngck del 2026-09-16 - la duena dejo los AirPods en 70 y el Alexa en 65, y el
// resumen salio con 75.000 y 70.000, dos veces).
//
// Cuando existe una fila aca, ESE es el precio del item: el catalogo pasa a ser el valor por defecto, no
// la verdad. Solo dos cosas escriben esta tabla, y ninguna de las dos es el modelo ni el cliente: la
// confirmacion explicita de la duena a una PendingOwnerQuestion de kind PRICE (src/routes/whatsapp.ts) y
// el panel (src/routes/admin/conversations.ts). Un precio dicho por el cliente no llega aca por ningun
// camino, y hay una prueba que lo fija.
model AgreedPrice {
  id             String            @id @default(cuid())
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  productId      String
  // El variantId, o "" cuando la linea no tiene variante. Cadena vacia y no NULL porque en Postgres dos
  // NULL no chocan entre si, asi que un @@unique con una columna nullable no impediria dos filas para el
  // mismo producto sin variante.
  variantKey     String            @default("")
  unitPrice      Decimal           @db.Decimal(12, 2)
  currency       String
  source         AgreedPriceSource
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([conversationId, productId, variantKey])
  @@index([conversationId])
}

// De donde salio la autorizacion. Las dos son la duena: por WhatsApp respondiendo y confirmando la
// pregunta del agente, o a mano desde el panel sobre la venta abierta. No hay un tercer valor, y
// especialmente no hay uno para "lo dijo el cliente".
enum AgreedPriceSource {
  OWNER_REPLY
  ADMIN_PANEL
}

model OrderItem {
  id           String  @id @default(cuid())
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  productId    String?
  productName  String
  // Denormalized the same way productId/productName already are (no @relation, resolved at read time,
  // same rationale as ShippingCityRule.label above) - which color/size actually sold, so order summaries
  // and owner notifications can show it without a join, and it survives the variant later being renamed
  // or deleted.
  variantId    String?
  variantLabel String?
  // E38: la linea de un COMBO. productId queda null (un combo no es un producto del catalogo) y el
  // nombre se guarda igual que siempre. Se denormaliza por el mismo motivo que productId: el pedido
  // tiene que seguir diciendo que se vendio aunque despues borren el combo.
  bundleId     String?
  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)
  // El precio que se le cobro de verdad a este cliente por esta linea, cuando NO es el del catalogo -
  // ver el modelo AgreedPrice. NULL = se cobro el precio de catalogo, que es lo que significaba toda
  // fila anterior a esta columna. unitPrice arriba siempre trae el precio efectivamente cobrado (el
  // acordado si existe), asi que ningun total cambia de forma; esta columna existe para poder DECIR que
  // esa linea salio de un descuento autorizado y no de un precio de catalogo viejo.
  agreedUnitPrice Decimal? @db.Decimal(12, 2)
  currency     String
}

enum TeamRole {
  EMPLOYEE
}

model TeamMember {
  id           String   @id @default(cuid())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId   String
  email        String   @unique
  passwordHash String
  name         String
  role         TeamRole @default(EMPLOYEE)
  active       Boolean  @default(true)
  // E28: sube de a uno al desactivar o borrar a este miembro, para cortarle las sesiones abiertas.
  sessionVersion Int      @default(0)
  createdAt    DateTime @default(now())
}

model FaqEntry {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  question   String
  answer     String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

enum LearnedFaqCandidateStatus {
  PENDING
  APPROVED
  DISCARDED
}

// A {question, answer} pair captured from a resolved ask_owner exchange - the owner already answered
// a customer's question once for real, this surfaces it as a suggested FaqEntry instead of discarding
// it after that one use. Never auto-published: stays PENDING until the owner approves it (possibly
// editing the wording first) from the admin panel. `occurrences` tracks how many times a
// near-duplicate question showed up before being reviewed, as a demand signal.
model LearnedFaqCandidate {
  id             String                    @id @default(cuid())
  business       Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String
  question       String
  answer         String
  conversationId String?
  occurrences    Int                       @default(1)
  status         LearnedFaqCandidateStatus @default(PENDING)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([businessId, status])
}

// Lo que el equipo quiso decirle al cliente cuando la ventana de 24h de WhatsApp ya estaba cerrada.
// Sin esto el texto real se perdia: se mandaba una plantilla generica de reenganche y el dueno tenia
// que acordarse de volver a escribir la respuesta cuando el cliente contestara (caso real 2026-09-14:
// la respuesta a David nunca se entrego y nadie la reenvio). Se encola aca y el webhook la entrega
// sola en cuanto el cliente escribe, porque ese mensaje entrante vuelve a abrir la ventana.
// E08 de ONIX-PLAN.md (2026-09-17): la rafaga de mensajes del cliente deja de vivir en la memoria del
// proceso. Antes, los mensajes que llegaban juntos esperaban su ventana de silencio (~8 s) en un Map con
// un setTimeout adentro (createBurstBuffer): el mensaje ya estaba grabado como Message, Meta ya habia
// recibido el 200 y nadie lo iba a reintentar, asi que un `pm2 restart` en esos 8 segundos -- hubo 103
// reinicios registrados -- se llevaba la rafaga entera y el cliente se quedaba sin ninguna respuesta.
//
// Cada fila es UN mensaje entrante esperando su turno. La rafaga es el conjunto de filas sin reclamar de
// una misma conversacion, y `flushAt` (el mismo para todas, recalculado en cada mensaje nuevo) es cuando
// se puede drenar. `claimedAt`/`claimedBy` son el reclamo de fila: el UPDATE condicionado a
// `claimedAt IS NULL` solo lo puede ganar un proceso, asi que dos drenajes simultaneos no producen dos
// respuestas.
//
// Solo se guarda lo que el cliente mando y a quien hay que contestarle. El negocio, el cliente y las
// credenciales NO se guardan aca: se leen de la base al drenar. Es la regla que dejo el despliegue del
// 2026-09-17 -- un hecho que se escribe una vez y se lee muchas es un hecho que va a mentir.
model PendingBurst {
  id                String       @id @default(cuid())
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId    String
  businessId        String
  customerId        String
  // A que numero se responde. Es el `from` del webhook, que puede no ser identico al telefono guardado
  // del cliente (prefijos que Meta normaliza distinto), y contestarle a otro numero no es una opcion.
  customerPhone     String
  rawText           String
  // La fila que el cliente toco en una lista interactiva, si toco alguna. Id, no texto.
  selectedProductId String?
  // Cuando lo mando el CLIENTE (el timestamp de Meta), no cuando lo procesamos: es desde ahi que esta
  // esperando, y es lo que decide si la respuesta ya salio vieja.
  customerSentAt    DateTime
  flushAt           DateTime
  claimedAt         DateTime?
  claimedBy         String?
  createdAt         DateTime     @default(now())

  @@index([claimedAt, flushAt])
  @@index([conversationId, claimedAt])
}

model QueuedOutboundMessage {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  businessId     String
  body           String
  // Quien dejo el mensaje en cola, solo para poder explicarlo en el panel.
  origin         QueuedOutboundOrigin @default(PANEL)
  createdAt      DateTime     @default(now())
  sentAt         DateTime?
  cancelledAt    DateTime?
  // Fase 7: la cola dejo de ser "se intenta una vez cuando el cliente escribe". Un item que fallaba
  // cortaba el drenaje entero de ese cliente y no dejaba rastro. Ahora cada item lleva su propio
  // contador, su proximo intento y el ultimo error, y al agotarse se marca en failedAt (dead-letter)
  // con un DeliveryFailure asociado, en vez de reintentarse para siempre en silencio.
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now())
  lastError      String?
  failedAt       DateTime?

  @@index([conversationId, sentAt])
  @@index([businessId, sentAt])
  @@index([sentAt, nextAttemptAt])
}

enum QueuedOutboundOrigin {
  PANEL
  OWNER_ANSWER
}

// Meta's delivery-status webhook reports failures asynchronously, after the send call already
// returned a wamid looking successful (src/routes/whatsapp.ts) - previously that only hit
// console.error, invisible unless someone went looking in the droplet's pm2 logs over SSH. This
// persists it so the admin panel can surface it live. `critical` marks a failure to reach the
// business owner specifically (recipient matches Business.contactPhone) - that's the dangerous case,
// since it usually means an ask_owner escalation the owner never saw.
model DeliveryFailure {
  id             String   @id @default(cuid())
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String
  wamid          String
  recipientPhone String
  errorCode      Int?
  errorMessage   String
  critical       Boolean  @default(false)
  resolved       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([businessId, resolved])
}

// Chat-style transcript of everything the bot sends to the business owner (alerts, sale
// confirmations, ask_owner escalations) and every reply the owner sends back - this is the only
// place the admin panel can show "did the owner actually get this" as a conversation instead of
// scattered pm2 log lines. `success: false` covers both a synchronous API error (template not
// approved, etc.) and the final fallback failing too - see recordOwnerMessage in
// src/delivery/ownerLog.ts.
model OwnerMessageLog {
  id           String                @id @default(cuid())
  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId   String
  direction    OwnerMessageDirection
  body         String
  success      Boolean               @default(true)
  errorMessage String?
  // `success` solo dice que Meta ACEPTO el envio, no que el dueno lo haya recibido. El acuse real llega
  // despues por el webhook de estados, que matchea por wamid - sin esta columna ese acuse llegaba y se
  // descartaba, porque los mensajes al dueno no viven en `Message`. Nullable: los avisos que fallaron no
  // tienen wamid, y ninguna fila historica lo tiene.
  wamid            String?               @unique
  deliveryStatus   MessageDeliveryStatus?
  deliveryStatusAt DateTime?
  // Conversacion que origino el aviso, cuando la hay. String suelto y no @relation a proposito: esto es
  // un registro de auditoria y tiene que sobrevivir al borrado de la conversacion. Lo escriben por ahora
  // solo los avisos del mecanismo de efectos requeridos (src/ai/requiredEffects.ts), que necesita poder
  // probar con un SELECT por conversacion que el aviso al dueno salio de verdad.
  conversationId String?
  createdAt    DateTime              @default(now())

  @@index([businessId, createdAt])
  @@index([conversationId, createdAt])
}

enum OwnerMessageDirection {
  OUT
  IN
}

model KeyRequest {
  id           String   @id @default(cuid())
  businessName String
  email        String
  phone        String
  planTier     PlanTier
  handled      Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model ActivationKey {
  id               String    @id @default(cuid())
  code             String    @unique
  planTier         PlanTier
  used             Boolean   @default(false)
  usedByBusinessId String?   @unique
  createdAt        DateTime  @default(now())
  usedAt           DateTime?
}

model Product {
  id           String           @id @default(cuid())
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId   String
  name         String
  description  String
  price        Decimal          @db.Decimal(12, 2)
  // E33 (2026-09-18): SIN default, y a proposito.
  //
  // Tenia `@default("USD")` contra `Business.currency @default("COP")`. Un producto dado de alta sin
  // moneda explicita quedaba en dolares dentro de un negocio colombiano, y despues se sumaba con el
  // resto del pedido como si fuera la misma unidad. Peor: un default hace que "nadie eligio" y "eligio
  // USD" sean indistinguibles en la base, asi que ni siquiera se puede arreglar despues sin adivinar.
  //
  // Ahora la moneda la resuelve createProduct desde el negocio (src/catalog/products.ts). Las filas que
  // ya estan NO se tocan: reescribir la moneda de un producto existente cambia lo que se le cobra a una
  // clienta, y eso lo decide el dueno mirando la lista, no una migracion.
  currency     String
  stock        Int              @default(0)
  category     String?
  // Single color/size products only (e.g. this exact watch model only comes in black, or this exact
  // shirt row only comes in size M - the same "one product per color/size" pattern this catalog already
  // uses for watches). A product that comes in SEVERAL colors/sizes under one name (e.g. "Diadema M4" in
  // red/yellow/green) uses ProductVariant below instead, which carries its own stock and own photos per
  // color/size.
  color        String?
  size         String?
  active       Boolean          @default(true)
  inquiryCount Int              @default(0)
  media        ProductMedia[]
  variants     ProductVariant[]
  promotions   Promotion[]
  bundleItems  BundleItem[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

// Optional sub-item layer for a product that has multiple color/size options each with independent stock
// and photos (e.g. one headband model in 3 colors, or a clothing item in several sizes). A Product with no
// rows here behaves exactly as before - this is additive, not a replacement for the simple case.
model ProductVariant {
  id        String         @id @default(cuid())
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  color     String?
  size      String?
  // E36 (2026-09-18): una talla XL puede costar mas que una S.
  //
  // NULL significa "el precio del producto", no "gratis". Es la diferencia entera de esta columna: con
  // un default de 0, un catalogo existente pasaria a tener todas sus variantes a cero y el bot venderia
  // regalado hasta que alguien lo viera. Con null, los catalogos de hoy se comportan EXACTAMENTE igual
  // que antes y solo cambia lo que el dueno decida cambiar.
  //
  // No lleva moneda propia a proposito: una variante es el mismo producto en otra talla o color, y dos
  // tallas del mismo producto en monedas distintas no es un caso real -- seria un producto distinto.
  // La moneda sigue siendo la del producto.
  price     Decimal?       @db.Decimal(12, 2)
  stock     Int            @default(0)
  active    Boolean        @default(true)
  media     ProductMedia[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([productId])
}

model ProductMedia {
  id        String          @id @default(cuid())
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  // Set when this photo belongs to one specific variant's color (not the product in general) - lets
  // send_product_media attach only the red headband's photos when the customer asked for red, instead of
  // every photo the product has across all colors.
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId String?
  type      MediaType
  url       String
  s3Key     String
  // El id que devolvio Meta al SUBIRLE este archivo, para no volver a subirlo en cada envio y, sobre
  // todo, para no darle una URL nuestra que tenga que descargar (ver uploadMediaToWhatsapp). Un id vive
  // 30 dias y es de la linea que lo subio, asi que se guarda junto al numero: si el negocio reconecta
  // WhatsApp con otra linea, el id viejo deja de servir y se vuelve a subir solo.
  whatsappMediaId        String?
  whatsappMediaAt        DateTime?
  whatsappMediaPhoneId   String?
  // Cuanto pesa el archivo en S3. Se guarda al subirlo (y se completa solo la primera vez que se manda
  // un archivo viejo, ver resolveSendableMedia) para que "esta foto se puede enviar?" sea una consulta
  // a la base y no un HeadObject a S3 por archivo. Sin esta columna, ningun camino de envio ni el panel
  // podian mirar el peso, asi que una foto cargada antes del tope del 2026-09-16 se intentaba enviar
  // igual y fallaba con 131053 despues de que el envio ya habia devuelto un wamid. Null = todavia no se
  // midio; nunca significa que el archivo este bien.
  bytes                  Int?
  // LA FICHA VISUAL DE ESTA FOTO (E12b, paso 2). La escribe el MISMO modelo de vision que mira la foto
  // que manda el cliente, con el mismo vocabulario: tipo, forma, color, material y texto visible. Sirve
  // para que una captura de un live se compare contra lo que se VE en el catalogo y no contra el nombre
  // comercial del producto - "redondo" contra "redondo", en vez de "redondo" contra "Serie 11 Mini
  // (Edicion Compacta y Elegante)", que fue lo que fallo el 2026-09-18.
  //
  // Se calcula una vez, al subir la foto, y se vuelve a calcular solo si la foto cambia. Null = todavia
  // no se indexo; el emparejamiento simplemente no cuenta con esa foto y el sistema cae al camino de
  // antes. Nunca bloquea nada.
  visionDescription      String?
  visionDescriptionAt    DateTime?
  createdAt DateTime        @default(now())
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

// Por que canal entro este cliente/conversacion. Hoy todo es WHATSAPP (unico canal implementado) y ese
// es el default, asi que ninguna fila existente cambia de comportamiento. Se agrega ahora, antes de
// construir el CRM encima, para que sumar Instagram/Facebook/Mercado Libre mas adelante no obligue a
// migrar datos ni a rehacer la ficha de cliente: el CRM ya lee y muestra el canal desde el dia uno.
// Deliberadamente NO se toca Customer.@@unique([businessId, phoneNumber]) ni se agrega una identidad
// por canal todavia - unificar a la misma persona entre canales (mismo humano en WhatsApp e Instagram)
// es una decision aparte, que recien tiene sentido cuando exista el segundo canal real.
enum Channel {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  MERCADOLIBRE
}

// Etapa del cliente como PERSONA, distinta de Conversation.status (que es el estado de UN ciclo de
// venta). Un cliente puede tener una conversacion SOLD cerrada y seguir siendo RECURRENTE; el status
// por conversacion no puede expresar eso. Default NUEVO para todas las filas existentes.
enum CustomerStage {
  NUEVO
  ACTIVO
  COMPRADOR
  RECURRENTE
  INACTIVO
}

model Customer {
  id            String         @id @default(cuid())
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String
  phoneNumber   String
  // UN CLIENTE DE PRUEBA (2026-09-18). No existe del otro lado: es un numero inventado para poder
  // mirar como contesta el bot desde la Bandeja, con el catalogo y la personalidad REALES del negocio.
  //
  // Lo unico que cambia es la ULTIMA milla: hacia un cliente simulado no se llama a la API de Meta. El
  // mensaje se guarda igual, asi que la conversacion se ve en el panel como cualquier otra -- y no hay
  // forma de que le llegue a una persona, porque el numero no es de nadie.
  //
  // No se puede prender desde el panel a proposito: lo pone scripts/simular-cliente.ts. Un cliente real
  // marcado asi dejaria de recibir mensajes sin que nadie se entere, y ese es el unico riesgo que tiene.
  simulated     Boolean        @default(false)
  // Nombre AUTORITATIVO: el que la clienta dijo por chat (save_customer_name) o el que el dueno escribio
  // a mano en el panel. Solo lo cambia una persona a proposito.
  name          String?
  // Lo que WhatsApp reporta en cada webhook (contacts[0].profile.name): el nombre que la persona puso en
  // SU propio perfil. Va aparte de `name` a proposito - lo refrescamos en cada mensaje y la persona puede
  // cambiarlo cuando quiera, asi que si compartiera campo con `name` un cambio de perfil ajeno borraria
  // el nombre bueno. Para mostrar se usa name ?? whatsappProfileName ?? phoneNumber.
  whatsappProfileName String?
  idNumber      String?
  deliveryPhone String?
  email         String?
  address       String?
  stage         CustomerStage  @default(NUEVO)
  channel       Channel        @default(WHATSAPP)
  // Como llego este cliente (campana, referido, etc). Texto libre a proposito: cada negocio tiene su
  // propio vocabulario de origen y no hay ninguno que sirva para todos.
  source        String?
  // Ultimo mensaje intercambiado con este cliente, en cualquiera de sus conversaciones. Existe para
  // que la lista de clientes del CRM pueda ordenar y paginar por recencia con un indice, en vez de
  // traer todas las conversaciones del negocio y agrupar en memoria (ver P10 del plan). Lo mantiene
  // recordMessage(); la migracion lo rellena con el ultimo mensaje real de cada cliente.
  lastContactAt DateTime?
  tags          String[]       @default([])
  notes         CustomerNote[]
  conversations Conversation[]
  orders        Order[]
  billableChats BillableChat[]
  createdAt     DateTime       @default(now())

  @@unique([businessId, phoneNumber])
  @@index([businessId, lastContactAt])
}

// Notas internas del negocio sobre un cliente. Nunca se le mandan al cliente ni entran al prompt del
// bot - son para el equipo humano que atiende.
model CustomerNote {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  body       String
  // Nombre de quien la escribio, resuelto al momento de crearla (dueño o empleado). Se guarda como
  // texto y no como FK a TeamMember a proposito: si ese empleado se borra despues, la nota sigue
  // diciendo quien la escribio en vez de quedar huerfana.
  authorName String?
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

// Catalogo de etiquetas del negocio: le da color y autocompletado a los strings que ya viven en
// Customer.tags. NO reemplaza ese String[] - una etiqueta escrita a mano que no este en esta tabla
// sigue funcionando exactamente igual que antes, solo se muestra con el color por defecto.
model CustomerTag {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  label      String
  color      String   @default("#5c6e65")
  createdAt  DateTime @default(now())

  @@unique([businessId, label])
}

model Conversation {
  id                           String                 @id @default(cuid())
  customer                     Customer               @relation(fields: [customerId], references: [id])
  customerId                   String
  // Canal por el que llego esta conversacion (ver enum Channel). Default WHATSAPP: hoy es el unico
  // canal implementado y toda fila existente queda igual.
  channel                      Channel                @default(WHATSAPP)
  status                       ConversationStatus     @default(NEW)
  intent                       ConversationIntent?
  // Fase 9 del plan maestro (2026-09-15): flag_conversation_intent silenciaba el bot sin que el dueno
  // supiera si el cliente lo pidio con sus propias palabras o si el modelo lo dedujo del contexto - un
  // "cerrar conversation" mal leido como SOLICITA_AGENTE se veia identico a un pedido real. Lo llena
  // setConversationIntent; null para toda fila anterior a esta fase (nunca se le pregunto al modelo).
  intentExplicit               Boolean?
  humanControl                 Boolean                @default(false)
  // POR QUE esta conversacion esta en manos de una persona. La duena pregunto, con razon, por que el bot
  // "se callaba solo": la base no guardaba nada que pudiera contestarlo, asi que la unica respuesta
  // posible era inferir del horario de los mensajes. Hay diez caminos que ponen humanControl en true y
  // seis de ellos no los dispara ningun clic - sin este campo, cual fue es una conjetura (2026-09-17).
  humanControlReason           HumanControlReason?
  humanControlAckSent          Boolean                @default(false)
  // Set/reset by setHumanControl every time humanControl flips (either direction) - the clock the
  // stalled-conversation watchdog measures against (jobs/escalationReminder.ts), independent of
  // PendingOwnerQuestion.createdAt so a flag_conversation_intent/manual-takeover escalation (neither of
  // which creates a PendingOwnerQuestion) is still caught if nobody answers it.
  humanControlSince            DateTime?
  stalledReminderStage         Int                    @default(0)
  stalledReminderSentAt        DateTime?
  followUpSentAt               DateTime?
  // Fase 9: una vez que la conversacion paso a ABANDONED con items en SaleState, jobs/abandonment.ts
  // manda la plantilla de recuperacion de carrito UNA sola vez - este flag evita reenviarla en cada
  // pasada del job mientras siga sin entregarse marcada como exitosa (mismo patron que followUpSentAt).
  // Se limpia si la conversacion se reactiva (getOrCreateOpenConversation), para que un abandono
  // posterior pueda volver a mandarla.
  cartRecoverySentAt           DateTime?
  // wamid del mensaje que el dueno tiene que responder. Sirve para matchear su respuesta citada; NO es
  // lo que define que haya una confirmacion viva - cuando los tres escalones de envio fallan no hay
  // wamid y la confirmacion existe igual. Eso lo marca pendingConfirmationAskedAt.
  pendingConfirmationMessageId String?                @unique
  pendingOrderSummary          String?
  pendingOrderItems            Json?
  // Momento en que se le pidio la confirmacion al dueno por primera vez. Es la marca de "hay una
  // confirmacion viva" y el reloj contra el que miden el perseguidor (Business.ownerReminderMinutes) y
  // el vencimiento (Business.ownerQuestionTimeoutHours), igual que PendingOwnerQuestion.createdAt.
  pendingConfirmationAskedAt   DateTime?
  // Ultimo reintento del perseguidor. A diferencia de PendingOwnerQuestion.remindedAt, este no es un
  // "una sola vez": se insiste cada ownerReminderMinutes hasta que el dueno responda o venza el plazo.
  pendingConfirmationRemindedAt DateTime?
  // Cuantas veces se intento hacerle llegar la pregunta (el pedido inicial cuenta como 1).
  pendingConfirmationAttempts  Int                    @default(0)
  // Por cual escalon de la escalera salio el ultimo intento. NONE = no salio por ninguno; el
  // perseguidor lo vuelve a intentar.
  pendingConfirmationChannel   OwnerConfirmationChannel?
  // El aviso salio por plantilla (unico contenido que cruza la ventana de 24h cerrada), asi que el
  // mensaje real con botones sigue debiendo salir: se manda apenas el dueno escriba cualquier cosa, que
  // es lo que reabre su ventana.
  pendingConfirmationButtonsQueued Boolean            @default(false)
  // Cuando toca el proximo reintento. Se guarda en vez de calcularse en la consulta porque el intervalo
  // crece con el numero de intento (ver CONFIRMATION_REMINDER_STEPS): con cadencia fija alcanzaba un
  // `lte` sobre la fecha del ultimo aviso, con espaciado creciente no. Ademas es lo que el panel muestra
  // como "proximo aviso".
  pendingConfirmationNextAttemptAt DateTime?
  // Cuantas veces se gasto la plantilla onix_owner_alert en esta confirmacion. Es UTILITY: se factura
  // por mensaje, y si no contesto la primera, la numero cuarenta no la va a despertar.
  pendingConfirmationTemplatesSent Int                @default(0)
  // Cuando salio la ultima. Sin esto, el tope se gastaba entero en los primeros 15 minutos y despues no
  // quedaba forma de alcanzarla en las 23 horas que faltan.
  pendingConfirmationLastTemplateAt DateTime?
  pendingOwnerQuestions        PendingOwnerQuestion[]
  contextSummary               String?
  contextSummarizedUpTo        Int?
  mediaSentProductIds          String[]               @default([])
  // Vitrina de categoria (2026-09-17): los productos cuya FOTO DE VITRINA (una sola, ver vitrinaPhoto)
  // ya salio en esta conversacion. Deliberadamente separado de mediaSentProductIds, que significa "este
  // cliente ya vio la ficha entera con todos sus medios": si fueran el mismo campo, ver la vitrina de
  // una categoria dejaria siete productos marcados como ya vistos y la ficha del que el cliente eligiera
  // saldria corta y sin una sola foto mas.
  browsePhotoProductIds        String[]               @default([])
  // Fase B del plan de catalogo y medios (2026-09-16), pieza 4: los ids de producto que el servidor
  // REALMENTE le presento al cliente en el ultimo bloque de catalogo, en el mismo orden en que salieron
  // numerados. Es contra esto que se resuelve "el 3" del turno siguiente - antes eso dependia de que el
  // modelo se acordara de su propia lista, que es justo lo que esta fase le quita de las manos.
  lastPresentedProductIds      String[]               @default([])
  unreadCount                  Int                    @default(0)
  order                        Order?
  saleState                    SaleState?
  agreedPrices                 AgreedPrice[]
  messages                     Message[]
  queuedOutbound               QueuedOutboundMessage[]
  pendingBursts                PendingBurst[]
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt

  @@index([pendingConfirmationAskedAt])
}

// Por cual escalon de la escalera de envio salio la pregunta de confirmacion al dueno:
// botones -> texto libre -> plantilla onix_owner_alert. NONE es "no salio por ninguno".
enum OwnerConfirmationChannel {
  BUTTONS
  TEXT
  TEMPLATE
  NONE
}

// One row per question escalated to the owner, instead of a single field on Conversation - a customer
// asking several distinct questions before the owner replies to the first one used to overwrite that
// single field each time, so her reply to an earlier question could never be matched back once a later
// question replaced it. Each escalation now gets its own trackable row, matched by the wamid of the
// alert the owner actually replies to.
model PendingOwnerQuestion {
  id             String                   @id @default(cuid())
  conversation   Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  wamid          String                   @unique
  question       String
  kind           PendingOwnerQuestionKind @default(TEXT)
  // Las RANURAS que el servidor espera llenar con la respuesta del dueno, escritas por el servidor
  // cuando manda la pregunta. Solo para kind PRICE hoy: { items: [{productId, variantKey, productName,
  // variantLabel, quantity, unitPrice, currency}], propuesta?: number[] }. La respuesta del dueno se
  // interpreta SOLO contra estas ranuras (N items, un numero cada uno) y `propuesta` es lo que el
  // servidor entendio, todavia sin efecto: un precio acordado no existe hasta que la duena confirma esa
  // propuesta. NULL para TEXT y PHOTO_PRODUCT, que es lo que era toda fila anterior a esta columna.
  payload        Json?
  createdAt      DateTime                 @default(now())
  remindedAt     DateTime?
  // E56 de ONIX-PLAN.md (2026-09-17): la fila se marca resuelta en vez de borrarse.
  //
  // Borrarla tiraba la evidencia mas valiosa que produce el sistema (el par pregunta real del cliente /
  // respuesta real del dueno, que alimenta el ciclo de aprendizaje de la FAQ), y ademas producia un
  // defecto que el cliente veia: `ownerWasNotifiedSince` (src/ai/requiredEffects.ts) prueba que una
  // imagen quedo atendida contando filas POSTERIORES a ella. Sin fila, la imagen quedaba "sin atender"
  // para siempre y cada turno volvia a forzar ask_owner_about_photo y a reenviar la misma respuesta
  // guardada - conversacion cmu4xfymx00bxq92kb1aj3iil, la misma identificacion de producto mandada dos
  // veces con cuatro minutos de diferencia.
  //
  // Toda consulta que signifique "pregunta abierta" filtra por `resolvedAt: null`. La unica que NO
  // filtra es a proposito: la que cuenta si al dueno se le aviso, porque avisado sigue avisado.
  resolvedAt     DateTime?

  @@index([conversationId])
  @@index([conversationId, resolvedAt])
}

// PHOTO_PRODUCT: the owner was sent the customer's actual photo/video to identify (ask_owner_about_photo
// in src/ai/tools.ts), not a plain text question - handleOwnerReply answers it differently (tries to
// resolve the owner's reply to a real catalog product and send its photo back, instead of forwarding the
// owner's raw text as-is).
// PRICE: el agente le pregunto al dueno por el precio de un pedido concreto (ask_owner_about_price en
// src/ai/tools.ts). La pregunta lleva los items exactos y sus precios actuales en `payload`, y la
// respuesta se resuelve contra esas ranuras en vez de reenviarse tal cual al cliente - ver la rama PRICE
// de handleOwnerReply en src/routes/whatsapp.ts.
enum PendingOwnerQuestionKind {
  TEXT
  PHOTO_PRODUCT
  PRICE
}

enum ConversationStatus {
  NEW
  INTERESTED
  QUOTED
  NEGOTIATING
  SOLD
  LOST
  // Fase 9 del plan maestro (2026-09-15), causa raiz C1+eje 18: el 61% de las conversaciones se quedaba
  // en NEW para siempre - nada las cerraba y no contaban como perdida. Distinto de LOST (rechazo
  // EXPLICITO del cliente): esta la pone jobs/abandonment.ts cuando el cliente deja de escribir por
  // Business.abandonedAfterHours. No es terminal como LOST - getOrCreateOpenConversation la reabre (vuelve
  // a NEW) si el cliente vuelve a escribir, para no perder el SaleState/carrito que ya tenia armado.
  ABANDONED
}

enum ConversationIntent {
  PQR
  DEVOLUCION
  NO_RECIBIDO
  SOLICITA_AGENTE
}

model Message {
  id                String       @id @default(cuid())
  conversation      Conversation @relation(fields: [conversationId], references: [id])
  conversationId    String
  role              MessageRole
  // QUIEN ESCRIBIO ESTE MENSAJE, cuando el rol es ASSISTANT (2026-09-18).
  //
  // `role` no alcanza: ASSISTANT es el bot Y la duena escribiendo desde el panel, y hasta hoy no habia
  // forma de distinguirlos. Eso hacia que los chequeos de salud le atribuyeran al bot lo que escribio
  // una persona: 20 de los 141 "respuesta duplicada" de la semana del 2026-09-18 eran ella mandando dos
  // mensajes seguidos, y el clasificador de E06 tuvo que deducirlo por la AUSENCIA de un AgentTurn.
  //
  // Es un dato, no una deduccion: lo escribe el camino del panel, que es el unico que sabe que del otro
  // lado hay una persona.
  humanAuthor       Boolean     @default(false)
  content           String
  mediaS3Key        String?
  mediaType         MediaType?
  // Nombre original del archivo. WhatsApp lo muestra en la burbuja del documento y el panel muestra el
  // mismo: sin esto, "catalogo-2026.pdf" se ve como "documento" en los dos lados.
  mediaFilename     String?
  // Forma de onda de una nota de voz: 44 valores de 0 a 99 separados por comas, calculados por el
  // servidor al guardar el mensaje. Ver el comentario de la migracion media_peaks.
  mediaPeaks        String?
  imageAnalysis     String?
  whatsappMessageId String?      @unique
  relatedProductId  String?
  // Fase 7 del plan maestro (2026-09-15): Meta manda el estado de entrega (sent/delivered/read/failed)
  // via el webhook de `statuses`, matcheado por whatsappMessageId - antes se descartaba en un
  // console.log (whatsapp.ts) y el panel no podia mostrar si un mensaje llego. Solo aplica a mensajes
  // ASSISTANT (los unicos que salen con un wamid propio); "failed" ya se registra aparte como
  // DeliveryFailure, asi que ese estado no vive aca.
  deliveryStatus    MessageDeliveryStatus?
  deliveryStatusAt  DateTime?
  createdAt         DateTime     @default(now())
}

enum MessageRole {
  CUSTOMER
  ASSISTANT
  SYSTEM
}

enum MessageDeliveryStatus {
  SENT
  DELIVERED
  READ
}

enum AiUsageKind {
  CHAT
  VISION
  VISION_ESCALATION
}

// LA UNIDAD QUE SE FACTURA (2026-09-17). Los planes dejaron de venderse por mensajes y pasaron a
// venderse por CHATS: una interaccion completa con un cliente, termine en compra o quede a medias.
//
// Una fila = un chat. Se abre cuando entra un mensaje de un cliente que no tiene ningun chat abierto,
// y se cierra sola a las CHAT_WINDOW_HOURS (48) sin que ese cliente escriba ni le escriban. No hay job
// que la cierre: "cerrada" es que lastMessageAt quedo fuera de la ventana, que es una comparacion de
// fechas contra la base y no un estado que haya que mantener al dia.
//
// La ventana se lleva por CLIENTE, no por Conversation, a proposito: getOrCreateOpenConversation abre
// una conversacion NUEVA en cuanto la anterior queda en SOLD o LOST, asi que un cliente que compra y
// vuelve a preguntar por el envio media hora despues tendria dos conversaciones - y, con la ventana
// atada a la conversacion, se le facturarian dos chats por una sola interaccion.
//
// periodStart es el mes en que el chat ABRIO, y no se recalcula: un chat que empieza el 31 y sigue el
// 1ro se cuenta una sola vez, en el mes en que empezo. Sin ese campo habria que decidir a que mes
// pertenece en cada consulta, y las dos consultas que lo decidieran distinto facturarian distinto.
model BillableChat {
  id             String       @id @default(cuid())
  business       Business     @relation(fields: [businessId], references: [id])
  businessId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  customerId     String
  // La conversacion que lo abrio. Es trazabilidad para el panel, no la llave de la ventana (ver arriba):
  // el mismo chat puede seguir en otra conversacion si la primera se cerro por venta.
  conversationId String?
  startedAt      DateTime     @default(now())
  lastMessageAt  DateTime     @default(now())
  messageCount   Int          @default(1)
  periodStart    DateTime
  createdAt      DateTime     @default(now())

  @@index([businessId, periodStart])
  @@index([customerId, lastMessageAt])
}

model AiUsageLog {
  id              String      @id @default(cuid())
  business        Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId      String
  conversationId  String?
  kind            AiUsageKind
  model           String
  cacheHitTokens  Int         @default(0)
  cacheMissTokens Int         @default(0)
  outputTokens    Int         @default(0)
  costUsd         Float
  createdAt       DateTime    @default(now())

  @@index([businessId, createdAt])
}

// Fase F, 2026-09-13 audit (F9): none of the backend safety nets in agent.ts (loop exhaustion,
// applyClaimBackstops repairs) left any queryable trace before this - only a console.error/warn nobody
// reads unless they happen to be tailing production logs. One row per intervention, cheap and
// best-effort (recordAgentIncident in agent.ts never lets a logging failure break the real reply).
// Fase B del plan de catalogo y medios (2026-09-16), pieza 7 (adelantada de la Fase A): una fila por
// turno del agente. Hasta ahora, saber que hizo un turno exigia cruzar AiUsageLog, Message y
// mediaSentProductIds y deducir; eso es arqueologia, y es lo que dejo vivir dias al defecto de catalogo
// sin que nadie lo viera. Se escribe best-effort: un fallo al registrar NUNCA rompe la respuesta real
// (mismo patron que recordAgentIncident).
model AgentTurn {
  id             String   @id @default(cuid())
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String
  conversationId String
  // Cuantas vueltas dio el lazo de tool-calling antes de devolver texto.
  iterations     Int      @default(0)
  // Herramientas llamadas EN ORDEN, incluidos los repetidos - "search_products, send_product_media".
  toolsCalled    String[] @default([])
  // Herramienta que se forzo por tool_choice en la primera llamada, si se forzo alguna. Junto con
  // toolsCalled es lo que permite medir la tasa de cumplimiento de tool_choice, que hoy no tiene numero.
  forcedTool     String?
  // Alcance que resolvio el servidor: "none", "one:<producto>", "group:<categoria> (n)", "all:n".
  scope          String   @default("none")
  // Texto exacto del bloque COMPUESTO POR EL SERVIDOR, en orden - se haya enviado como mensaje aparte o
  // haya viajado adentro del mensaje del modelo (marca {{BLOQUE_CATALOGO}}, 282c8f1). Se guarda igual en
  // los dos casos a proposito: la auditoria tiene que poder ver el bloque que compuso el servidor sin
  // depender de donde termino saliendo. catalogInlined dice cual de los dos casos fue - sin mirarlo, una
  // fila con blocks no vacio NO significa que el cliente haya recibido un mensaje aparte con ese texto.
  // Desde el camino de UN SOLO AUTOR (2026-09-16) hay un tercer caso: con catalogAuthor = "modelo" el
  // bloque de esta columna NO se envio nunca - se compuso solo como fallback y el agente escribio el
  // mensaje el mismo.
  blocks         String[] @default([])
  // true = el modelo puso la marca {{BLOQUE_CATALOGO}} y el bloque de arriba viajo adentro de su mensaje;
  // false = salio como mensaje aparte, o no hubo bloque. Es el denominador de la tasa de omision de la
  // marca, que es el numero con el que se sabe si el cambio del 2026-09-16 sirvio.
  catalogInlined Boolean  @default(false)
  // UN SOLO AUTOR (2026-09-16). Quien escribio el mensaje de catalogo que recibio el cliente:
  // "modelo" = el agente lo escribio entero con los datos estructurados del servidor y la verificacion
  // contra el catalogo lo aprobo; "servidor" = la verificacion fallo dos veces y salio el bloque
  // compuesto, que es texto leido de la base. null = este turno no paso por ese camino (alcance
  // distinto de "one", o sin alcance). Es el denominador de la tasa de caida al fallback: el incidente
  // solo da el numerador.
  catalogAuthor  String?
  // E76 (2026-09-18): quien resolvio el efecto requerido de este turno. Misma forma y mismo motivo que
  // catalogAuthor, pero para el otro camino - el de los efectos requeridos.
  //
  //   "modelo"     lo hizo solo, a la primera
  //   "reintento"  hizo falta forzarle la herramienta con tool_choice
  //   "servidor"   cayo al fallback: el texto lo escribio el codigo, sin modelo adentro
  //   "escalado"   no se pudo ni con el fallback
  //   null         este turno no exigia ningun efecto
  //
  // POR QUE ESTA COLUMNA EXISTE: la medida del norte es "las lineas del prompt bajando con errores en
  // cero", y esa medida no ve los fallbacks. Cada turno en "servidor" ES un chatbot - texto fijo escrito
  // por codigo. Sin esta columna se puede cumplir la meta del plan con Onix funcionando como chatbot en
  // un tercio de los turnos y nada lo diria. El contador existia (requiredEffectStats) pero vivia en
  // memoria y se perdia en cada reinicio; hubo trece en un dia.
  effectAuthor   String?
  // Ids de producto cuyos medios salieron con los bloques de este turno.
  mediaProductIds String[] @default([])
  // Pieza 5 del plan de catalogo y medios, EN MODO SOMBRA: lo que la validacion contra el catalogo real
  // HABRIA marcado en el texto de este turno, un JSON por hallazgo ({kind, value, line}). Nada de esto
  // cambia lo que recibe el cliente - la activacion es un cambio aparte, despues de 48h de datos.
  // Array vacio = el turno no marco nada, que es el caso normal.
  shadowFindings String[] @default([])
  createdAt      DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([conversationId, createdAt])
}

model AgentIncident {
  id             String            @id @default(cuid())
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String
  conversationId String?
  kind           AgentIncidentKind
  // Fase 0 del plan maestro (2026-09-15): nombre del guard/patron que disparo este incidente
  // (p.ej. "variant_denial", "media_promise_retraction"). Sin esto, P5 (backstops por 100 turnos)
  // solo puede reportarse agregado; con esto se puede desglosar por guard, que es lo que deja ver
  // cuando una fase realmente elimino una clase de falla en vez de solo bajar el conteo total.
  // Nullable y sin backfill: las filas viejas quedan sin guard, no se les inventa uno.
  guard          String?
  detail         String
  createdAt      DateTime          @default(now())

  @@index([businessId, createdAt])
}

enum AgentIncidentKind {
  LOOP_EXHAUSTED
  BACKSTOP_INTERVENTION
  DEGRADED_REPLY
  // Una API externa (Anthropic, DeepSeek, Groq) rechazo o fallo una llamada. Existe porque esos
  // caminos atrapan el error y siguen sin romper la conversacion: sin una fila aca, un fallo total
  // y permanente se ve identico a "esta funcion nunca hizo falta". Ver la llave de Anthropic sin
  // workspace, que dejo la escalacion de vision muerta semanas sin que nadie se enterara.
  EXTERNAL_API_FAILURE
  // La respuesta del bot tardo mas de STALE_REPLY_MINUTES en generarse y se descarto sin mandarla.
  // Pasa cuando el proveedor de IA esta degradado: el 2026-09-14, con DeepSeek caido, una respuesta
  // salio 30 minutos despues del mensaje del cliente, ya fuera de contexto. La conversacion pasa a
  // control humano en vez de mandar algo viejo.
  STALE_REPLY_DISCARDED
  // Correccion Fase 4 del plan maestro (2026-09-15): una PendingOwnerQuestion (ask_owner) llego a
  // Business.ownerQuestionTimeoutHours sin respuesta del dueno. blockedBy se limpia solo (ver
  // saleState.ts) y la conversacion pasa a humanControl - antes se quedaba muda para siempre.
  OWNER_QUESTION_TIMEOUT
  // Fase 9: jobs/abandonment.ts paso esta conversacion a ABANDONED por inactividad del cliente.
  CONVERSATION_ABANDONED
  // Fase 9: una escalacion de flag_conversation_intent (PQR/devolucion/no_recibido/pide agente) paso
  // Business.intentEscalationTimeoutHours sin que el dueno respondiera - se le devolvio el control al
  // bot solo, ver conversationIntent en jobs/escalationReminder.ts.
  INTENT_ESCALATION_TIMEOUT
  // Se vencio Business.ownerQuestionTimeoutHours con una confirmacion de venta sin responder: el cliente
  // pago y el dueno nunca contesto "¿Te llego el pago?". La conversacion pasa a control manual. Es el
  // caso mas caro de todos, porque hay plata de por medio.
  SALE_CONFIRMATION_TIMEOUT
}

// Fase 8, punto 5 del plan maestro (2026-09-15): las sesiones del panel vivian en la memoria del
// proceso (el MemoryStore por omision de express-session). Cada `pm2 restart` - 103 en lo que va del
// registro - deslogueaba a todo el mundo, y ademas el propio express-session avisa que ese store
// pierde memoria y no sirve para produccion.
//
// El nombre de la tabla y sus columnas los fija connect-pg-simple, no nosotros: esta modelada aca para
// que Prisma la conozca y no la reporte como drift, no para usarla desde el codigo.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("session")
}

// E29 (2026-09-18). AUDITORIA DE LA CONSOLA DE PLATAFORMA.
//
// La consola puede activar y desactivar negocios, cambiar su plan y su techo de gasto, y leer los
// mensajes del dueno. Hasta hoy no quedaba rastro de nada de eso. Con clientes que pagan, "alguien
// desactivo el negocio de Milena el martes" no tenia forma de responderse.
//
// UNA TABLA PARA DOS COSAS, a proposito: el bloqueo por intentos se calcula contando los LOGIN_FAILED
// recientes de esa IP. Una segunda tabla de "intentos" tendria que mantenerse en sincronia con esta, y
// el dia que se desincronicen el bloqueo dejaria de coincidir con lo que dice la auditoria. El registro
// de lo que paso ES el contador.
model PlatformAuditLog {
  id String @id @default(cuid())
  // LOGIN_OK / LOGIN_FAILED / LOGIN_BLOCKED / LOGOUT / BUSINESS_UPDATED.
  action String
  // El correo TAL COMO SE INTENTO, exista o no: en un intento fallido es el unico dato que hay sobre
  // quien lo intento.
  actorEmail String?
  // Desde donde. Es lo que permite bloquear por intentos sin una segunda tabla.
  ip String?
  // Sobre que negocio, cuando la accion toca uno. SIN relacion declarada a proposito: si el negocio se
  // borra, el rastro de lo que se le hizo tiene que sobrevivir. Una relacion con onDelete: Cascade
  // borraria justamente la evidencia que esta tabla existe para guardar.
  businessId String?
  // Que cambio, en texto libre. No se guardan valores de secretos aca nunca.
  detail String?
  createdAt DateTime @default(now())

  // El indice del bloqueo: se consulta por accion + ip + ventana de tiempo, en ese orden.
  @@index([action, ip, createdAt])
  @@index([businessId, createdAt])
}

// E20 / E21 (2026-09-18). EL MENSAJE ENTRANTE EXISTE AUNQUE EL PROCESO MUERA.
//
// El webhook respondia 200 y DESPUES procesaba, en el mismo tick de la peticion. Meta no reintenta: si
// el proceso moria en el medio -- y hubo 103 reinicios registrados -- ese turno no existio nunca para
// nadie. No quedaba ni el rastro de que el cliente habia escrito.
//
// Ahora el webhook hace tres cosas y ninguna mas: validar la firma, INSERTAR el lote entero, responder
// 200. Si el insert falla, no se responde 200 y Meta reintenta, que es exactamente lo que se quiere.
model InboundEvent {
  id String @id @default(cuid())

  // LA IDEMPOTENCIA, Y OCURRE ANTES DE GASTAR. Hasta hoy la deduplicacion por wamid pasaba recien en
  // recordMessage, o sea DESPUES de haber pagado descarga de medios, subida a S3, vision y
  // transcripcion: un reintento de Meta las pagaba todas de nuevo (y contaba un chat facturable de mas).
  //
  // No es el wamid pelado: Meta manda VARIOS estados para el mismo mensaje saliente (sent, delivered,
  // read) y todos traen el mismo id. Con el wamid como clave unica solo entraria el primero y se
  // perderian los otros dos. Por eso la clave es "msg:<wamid>" o "st:<wamid>:<estado>".
  dedupeKey String @unique

  // "MESSAGE" o "STATUS".
  kind String
  // El wamid pelado, para poder buscar. No es unico: ver arriba.
  wamid String
  // De que numero entro. El negocio se resuelve en el consumidor, no aca: el webhook no consulta la base
  // mas que para insertar.
  phoneNumberId String?

  // El elemento tal como lo mando Meta, entero. Es lo que se reprocesa.
  payload Json

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  // Reintento y carta muerta, mismo patron que QueuedOutboundMessage.
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  // Reclamo para varios procesos: quien lo toma lo marca hasta cuando. Si el proceso muere, vence solo.
  lockedUntil   DateTime?
  lastError     String?
  // Carta muerta: se agotaron los intentos. Visible en el panel en vez de perdido en silencio.
  failedAt      DateTime?

  // El indice del consumidor: pendientes que ya tocan, en orden de llegada.
  @@index([processedAt, nextAttemptAt])
  @@index([failedAt])
}

// E23 (2026-09-18). EL ARRIENDO DE UN JOB, PARA QUE DOS `worker` NO HAGAN EL MISMO TRABAJO.
//
// `sinSolape` (src/jobs/sinSolape.ts) impide que un job se pise A SI MISMO dentro de un proceso. No
// puede ver al OTRO proceso. Con `web` y `worker` separados eso ya importa: el dia que haya dos
// `worker` -- por carga o por un despliegue que solapa el viejo con el nuevo -- los dos correrian
// `saleConfirmationChaser` a la vez y a la duena le llegarian dos confirmaciones del mismo pedido.
//
// Una fila por job. Quien la toma la marca hasta cuando; si el proceso muere, el arriendo vence solo y
// el siguiente lo agarra. Es el mismo patron que `InboundEvent.lockedUntil`, que es el que ya usa la
// cola de entrada.
model JobLease {
  // El nombre del job, tal como lo registra `sinSolape`.
  name String @id

  // Hasta cuando esta tomado. Nulo o vencido = libre.
  lockedUntil DateTime?
  // Quien lo tomo: `<host>:<pid>`. Solo para poder mirar quien esta corriendo que cosa.
  holder      String?
  // Cuando termino la ultima pasada que lo solto bien. Un job que no aparece aca hace rato es un job
  // que se esta muriendo a la mitad todas las veces.
  lastRunAt   DateTime?
}

// E23 (2026-09-18). EL BREAKER DEL MODELO, COMPARTIDO ENTRE PROCESOS.
//
// Cuando DeepSeek retira o cuelga un modelo (paso de verdad el 2026-09-14), la primera peticion que
// falla marca el modelo como caido y las siguientes van directo al de respaldo, sin volver a pagar el
// timeout. Mientras eso vivio en memoria, cada proceso tenia que aprenderlo por su cuenta: con `web` y
// `worker` separados (y manana con dos `worker`), el segundo proceso volvia a colgar a un cliente
// durante el timeout entero para enterarse de algo que el primero ya sabia. Y `/health` mostraba el
// breaker del proceso que atendio la peticion, no el del sistema.
model ModelBreaker {
  // El id del modelo que fallo, tal como se le pide al proveedor.
  model String @id

  failedAt DateTime @default(now())
  // Hasta cuando no se lo vuelve a intentar. Vencido = se reintenta, y si anda, vuelve solo.
  until    DateTime
  // El error, para poder mirar por que se cayo sin tener que buscar en los logs.
  detail   String?
}

// E37 (2026-09-18). UNA PROMOCION ES UN DATO, NO UNA FRASE.
//
// Hasta hoy un descuento del negocio no existia como dato: la duena se lo escribia al bot en
// `customInstructions` ("esta semana 20% en relojes") y el modelo tenia que acordarse. Acordarse es
// justo lo que el modelo no garantiza: lo aplicaba a veces si y a veces no, y cuando lo aplicaba
// calculaba el numero el mismo.
//
// `AgreedPrice` NO es esto y se queda como esta: es un acuerdo puntual con UNA clienta ("te lo dejo en
// 45"), autorizado por la duena en esa conversacion. Una promocion es del negocio y vale para todas.
//
// El descuento se aplica en `precioDeVenta` (src/catalog/precioDeVenta.ts), que es el unico lugar que
// le pone precio a una linea -- asi lo que el bot DICE y lo que se COBRA no pueden separarse.
enum PromotionKind {
  // Un porcentaje sobre el precio de lista.
  PERCENT
  // Un monto fijo de descuento, en la moneda del negocio.
  AMOUNT
}

enum PromotionScope {
  // Todo el catalogo del negocio.
  GLOBAL
  // Una categoria, por nombre (Product.category es un string, no hay tabla de categorias).
  CATEGORY
  // Un producto puntual.
  PRODUCT
}

model Promotion {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  // Como la llama la duena. Es lo que el bot le dice a la clienta: "Promo de aniversario".
  name  String
  kind  PromotionKind
  // Porcentaje (0-100) o monto, segun `kind`. Decimal por lo mismo que el resto de la plata (E33).
  value Decimal       @db.Decimal(12, 2)

  scope PromotionScope
  // Solo con scope CATEGORY. Se guarda normalizado para poder comparar sin acentos ni mayusculas.
  categoryNormalized String?
  // Como la escribio la duena, para mostrarla igual en el panel.
  categoryLabel      String?
  // Solo con scope PRODUCT.
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String?

  // Cuantas unidades hacen falta para que aplique. 1 = siempre.
  minQuantity Int @default(1)

  // Vigencia. Null de los dos lados = vigente mientras `active` sea true.
  startsAt DateTime?
  endsAt   DateTime?

  // El apagado a mano, sin tener que borrarla ni tocar las fechas.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, active])
  @@index([productId])
}

// E38 (2026-09-18). UN COMBO ES UN PRODUCTO COMPUESTO, NO PROSA EN UNA DESCRIPCION.
//
// Hasta hoy un combo se cargaba como un Product mas, con su contenido escrito en `description`
// ("incluye pulsos en Metalico Plateado, Cuero Marron, Silicona Azul..."). Eso ya rompio la busqueda por
// color en produccion el 2026-09-13: esa prosa hacia que UN producto coincidiera con casi cualquier
// consulta de color (ver el comentario en src/catalog/products.ts, cerca de canonicalColors).
//
// El arreglo de entonces fue dejar de escanear la descripcion. El arreglo de verdad es este: el
// contenido del combo deja de ser texto y pasa a ser filas que apuntan a productos reales. Con eso, el
// stock de un combo se CALCULA (lo que alcance el componente mas escaso) en vez de ser un numero que
// alguien mantiene a mano, y la busqueda por color no tiene nada que malinterpretar.
model Bundle {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String

  name        String
  // Para que sirve el combo, con las palabras de la duena. NO es donde vive su contenido: eso son las
  // filas de BundleItem. Esa diferencia es la etapa entera.
  description String?
  // Su propio precio, que es el motivo por el que un combo existe: no es la suma de sus partes.
  price       Decimal  @db.Decimal(12, 2)
  currency    String
  active      Boolean  @default(true)

  items     BundleItem[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([businessId, active])
}

model BundleItem {
  id       String @id @default(cuid())
  bundle   Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  bundleId String

  // Productos REALES del catalogo. Si el producto se borra, la fila se va con el: un combo que promete
  // algo que ya no existe es peor que un combo que desaparece.
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  // La variante puntual, cuando el combo trae una talla o color concreto.
  variantId String?

  quantity Int @default(1)

  @@index([bundleId])
  @@index([productId])
}
