generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanTier {
  BASICO
  EMPRENDEDOR
  NEGOCIO
}

enum OrderFulfillmentStatus {
  PENDING
  SHIPPED
  CANCELED
}

model Business {
  id                        String                    @id @default(cuid())
  name                      String
  description               String?
  customInstructions        String?
  assistantName             String?
  botTone                   String?
  botDialect                String?
  botGreeting               String?
  botNeverSay               String?
  autoSendPhotoOnQuote      Boolean                   @default(true)
  // Fase E, 2026-09-13 audit (F8): a third photo mode - list the catalog by text and OFFER photos instead
  // of sending them right away, unless the customer's own message already asked for photos (then send
  // list+photos together). Independent flag rather than a 3rd value of autoSendPhotoOnQuote - keeps that
  // field's existing AUTO/REACTIVE meaning untouched for every business that hasn't opted into this.
  offerPhotosBeforeSending  Boolean                   @default(false)
  requirePaymentProof       Boolean                   @default(true)
  businessCategory          String?
  email                     String                    @unique
  passwordHash              String
  planTier                  PlanTier                  @default(BASICO)
  active                    Boolean                   @default(false)
  contactPhone              String?
  contactName               String?
  passwordResetCode         String?
  passwordResetExpiresAt    DateTime?
  capNotifiedAt             DateTime?
  whatsappPhoneNumberId     String?                   @unique
  whatsappBusinessAccountId String?
  whatsappPhoneNumber       String?
  whatsappAccessToken       String?
  // Fase 7 del plan maestro (2026-09-15): los tokens de Embedded Signup expiran a los 60 dias (ver
  // whatsapp/embeddedSignup.ts) y hasta ahora nada guardaba esa fecha ni avisaba. whatsappConnect.ts
  // la setea al conectar; jobs/tokenExpiry.ts avisa al dueno y a Zaqi 7 dias antes y limpia
  // whatsappTokenExpiryNotifiedAt en cada reconexion para que la proxima expiracion vuelva a avisar.
  whatsappTokenExpiresAt        DateTime?
  whatsappTokenExpiryNotifiedAt DateTime?
  // Error 190 de Meta (token vencido o revocado) marca la conexion como caida - src/whatsapp/outbound.ts
  // la setea al clasificar ese error, whatsappConnect.ts la limpia al reconectar. Distinto de un token
  // que todavia no vencio pero que Meta igual rechazo (revocado a mano, WABA desconectada).
  whatsappConnectionBrokenAt    DateTime?
  followUpTemplateName      String?
  followUpTemplateLanguage  String                    @default("es")
  followUpDelayHours        Int                       @default(24)
  ownerReminderMinutes      Int                       @default(180)
  // Correccion Fase 4 del plan maestro (2026-09-15), causa raiz C2: blockedBy (ver saleState.ts) no
  // tenia salida si el dueno nunca respondia una pregunta escalada - la conversacion quedaba muda para
  // siempre. Pasadas estas horas sin respuesta, jobs/escalationReminder.ts limpia blockedBy, pasa la
  // conversacion a control humano y avisa al dueno y al panel. Configurable por negocio, igual que
  // ownerReminderMinutes arriba.
  ownerQuestionTimeoutHours Int                       @default(24)
  // Fase 9 del plan maestro (2026-09-15): flag_conversation_intent (PQR/devolucion/no_recibido/pide
  // agente) deja el bot mudo (humanControl=true) hasta que el dueno responda, sin salida si nunca lo hace
  // - un intent que el MODELO dedujo mal (ver Conversation.intentExplicit) deja al cliente sin respuesta
  // para siempre y sin forma de volver salvo que alguien entre al panel. Mismo patron de escape que
  // ownerQuestionTimeoutHours arriba: pasadas estas horas sin que humanControlSince se refresque (el
  // dueno nunca respondio desde el panel), jobs/escalationReminder.ts devuelve el control al bot solo.
  // Default mas largo que ownerQuestionTimeoutHours porque aca no hay una pregunta puntual bloqueando el
  // checkout, es la conversacion entera, y el stage-2 del watchdog de estancadas ya avisa a las 24h.
  intentEscalationTimeoutHours Int                     @default(48)
  // Fase 9: umbral de inactividad del CLIENTE (no del dueno) antes de que la conversacion pase a
  // ABANDONED - ver jobs/abandonment.ts. Configurable porque un negocio de ticket alto puede querer un
  // umbral mas largo que uno de compra impulsiva.
  abandonedAfterHours       Int                       @default(72)
  // Fase 9: plantilla aprobada para recuperar un carrito (SaleState con items) cuando su conversacion
  // pasa a ABANDONED - distinta de followUpTemplateName (esa es post-venta, esta es pre-venta). Vacio =
  // desactivado, mismo patron que followUpTemplateName.
  cartRecoveryTemplateName     String?
  cartRecoveryTemplateLanguage String                 @default("es")
  // Gendered address tone (ej: alternar el nombre con "linda"/"bella" para mujeres, "Sr."/"Señor" para
  // hombres) - encontrado en el prompt de MAGByLizN, promovido a mecanismo core (detectar genero,
  // corregir si el cliente se queja) pero las palabras exactas quedan opt-in por negocio: off por
  // defecto, otro negocio puede no querer ese trato.
  genderedAddressEnabled    Boolean                   @default(false)
  femaleAddressTerm         String?
  maleAddressTerm           String?
  // Que modalidades de pago de ENVIO ofrece este negocio (distinto del canal de pago - Nequi/tarjeta/etc,
  // ver PaymentMethod arriba). Vacio = el negocio no usa este concepto, el flujo de pago generico sigue
  // igual que siempre. Encontrado en el prompt de MAGByLizN (pagar todo anticipado / solo producto
  // anticipado+envio contraentrega / todo contraentrega), promovido a mecanismo core reusable.
  shippingPaymentModalities ShippingPaymentModality[] @default([])
  // Fase 2 del plan maestro (2026-09-15): motor de venta ejecutable (SaleState) contra el modelo
  // leyendo/escribiendo el estado por su cuenta. Off por defecto - bandera de reversion explicita del
  // plan: un negocio se prueba primero con esto en true, el resto sigue exactamente igual que hoy.
  saleStateEnabled         Boolean                   @default(false)
  // Efectos requeridos (2026-09-15): antes de enviar la respuesta, el motor verifica contra la base que
  // el turno haya producido el efecto que su propio texto dice haber producido, y si falta lo reintenta,
  // lo ejecuta desde el codigo o escala. Off por defecto - encendido en un negocio a la vez. Ver
  // src/ai/requiredEffects.ts.
  requiredEffectsEnabled    Boolean                   @default(false)
  // Fase 11 del plan maestro (2026-09-15), causa raiz C5: el pais del negocio deja de estar cableado en
  // el codigo. Elige la entrada de src/config/countries.ts que decide el formato de precio, que forma
  // tiene un telefono y un documento, como se reconoce una direccion despachable y como se le pide cada
  // dato al cliente. Default "CO" porque es lo que todo negocio existente ya era.
  countryCode               String                    @default("CO")
  // Moneda y zona horaria arrancan del pais (ver countries.ts) pero son campos propios: un negocio
  // colombiano que cobra en USD, o uno mexicano en Cancun, existe y no deberia necesitar un pais nuevo.
  currency                  String                    @default("COP")
  timezone                  String                    @default("America/Bogota")
  // Horario de atencion, forma { "mon": ["09:00","18:00"], ..., "sun": null } - ver
  // src/config/businessHours.ts. null = sin cargar, y entonces nada entra al prompt.
  businessHours             Json?
  // Si este negocio pide documento de identidad para despachar. Antes era una constante de Colombia.
  requiresIdDocument        Boolean                   @default(true)
  // Zonas de envio (ShippingRate.label, comparado sin tildes ni mayusculas) donde el documento NO se
  // pide. Antes era la lista literal ["bogota","soacha"] adentro de orders/checkoutState.ts, igual para
  // todos los negocios del producto. La migracion la copia tal cual a los negocios que ya existian.
  idDocumentExemptZones     String[]                  @default([])
  products                  Product[]
  customers                 Customer[]
  paymentMethods            PaymentMethod[]
  shippingRates             ShippingRate[]
  shippingCityRules         ShippingCityRule[]
  categoryAliases           CategoryAlias[]
  aiUsageLogs               AiUsageLog[]
  faqEntries                FaqEntry[]
  learnedFaqCandidates      LearnedFaqCandidate[]
  deliveryFailures          DeliveryFailure[]
  agentIncidents            AgentIncident[]
  agentTurns                AgentTurn[]
  customerNotes             CustomerNote[]
  customerTags              CustomerTag[]
  ownerMessageLogs          OwnerMessageLog[]
  orders                    Order[]
  teamMembers               TeamMember[]
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
}

enum PaymentMethodType {
  TRANSFERENCIA
  TARJETA
  EFECTIVO
}

// Who pays for shipping and when - a different axis than PaymentMethodType (which channel: Nequi, card,
// cash). A business can offer any subset (see Business.shippingPaymentModalities); most businesses won't
// use this concept at all and leave it empty.
enum ShippingPaymentModality {
  PREPAID_ALL // paga producto + envio, todo por adelantado
  PREPAID_PRODUCT_COD_SHIPPING // paga el producto por adelantado, el envio se paga contraentrega
  COD_ALL // paga todo (producto + envio) contraentrega
}

model PaymentMethod {
  id         String            @id @default(cuid())
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  type       PaymentMethodType
  label      String
  details    String
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
}

// A structured price per shipping tier (city/zone label -> real cost), so the agent has a real number to
// fetch instead of only the free-text tier table a business writes into its own customInstructions -
// mirrors PaymentMethod's role for payment data. Optional: a business with no rows here just isn't
// affected, its customInstructions prose keeps working exactly as before.
model ShippingRate {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  label      String
  cost       Decimal  @db.Decimal(12, 2)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([businessId])
}

// A literal, exact city-name -> ShippingRate.label mapping. Deliberately NOT a full city taxonomy: this
// only structurally solves the enumerable case (a business typing "Bogota"/"Soacha" as an exact rule) -
// abstract regional tiers (e.g. "principales ciudades de Colombia") stay pure model judgment via
// customInstructions, exactly as today. `label` is a plain string reference to ShippingRate.label,
// resolved at READ time rather than a relation/FK to ShippingRate.id: if that ShippingRate row is later
// renamed or deleted, this row does NOT become an invalid FK - it just silently stops resolving to a real
// cost, treated identically to "no rule configured" instead of crashing. `city` keeps the original
// as-typed text for any future admin UI; `normalizedCity` (lowercase, accent-stripped via
// normalizeForMatch) is the actual match key, so "Bogota" and "Bogotá" both resolve to the same rule.
model ShippingCityRule {
  id             String   @id @default(cuid())
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String
  city           String
  normalizedCity String
  label          String
  createdAt      DateTime @default(now())

  @@unique([businessId, normalizedCity])
  @@index([businessId])
}

// Per-business category-word synonyms (e.g. "reloj" = "smartwatch" for a tech reseller, "guineo" =
// "banano" for a fruit stand) - deliberately NOT a fixed dictionary in code (see attributeTaxonomy.ts):
// which words mean the same product type is entirely vertical-specific, so each business configures its
// own. `synonym` is the word that gets folded INTO `canonical` when matching (e.g. synonym="smartwatch",
// canonical="reloj") - a customer/catalog word with no configured alias just matches itself, unchanged
// from before this table existed. `normalizedSynonym` (via normalizeForMatch) is the actual match key.
model CategoryAlias {
  id                String   @id @default(cuid())
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId        String
  canonical         String
  synonym           String
  normalizedSynonym String
  createdAt         DateTime @default(now())

  @@unique([businessId, normalizedSynonym])
  @@index([businessId])
}

model Order {
  id                 String                 @id @default(cuid())
  business           Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId         String
  customer           Customer               @relation(fields: [customerId], references: [id])
  customerId         String
  conversation       Conversation           @relation(fields: [conversationId], references: [id])
  conversationId     String                 @unique
  summary            String
  shippingAddress    String?
  paymentMethodLabel String?
  shippingCost       Decimal?               @db.Decimal(12, 2)
  totalAmount        Decimal                @db.Decimal(12, 2)
  currency           String
  csatRating         Int?
  csatAskedAt        DateTime?
  fulfillmentStatus  OrderFulfillmentStatus @default(PENDING)
  shippedAt          DateTime?
  shipmentNote       String?
  shipmentMediaS3Key String?
  shipmentMediaType  String?
  canceledAt         DateTime?
  items              OrderItem[]
  createdAt          DateTime               @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, fulfillmentStatus])
}

// Fase 2 del plan maestro (2026-09-15), causa raiz C1: hasta ahora ningun lugar del sistema sabia que
// producto elegio el cliente, que variante, y que datos de entrega ya dio MIENTRAS la venta esta en
// curso (ver checkoutStateFromDb.ts:41-46) - solo vivia en la memoria del modelo, de ahi salian las
// repreguntas y los guards que leen prosa para adivinar el estado. Esta tabla es la unica escrita por
// el motor de venta (src/orders/saleState.ts), nunca por el modelo directamente.
//
// Deliberadamente chica: NO guarda missing/subtotal/total/shippingCost ni ciudad/barrio por separado -
// esos se derivan en cada lectura (computeCheckoutState + resolveShippingRateForCity, igual que ya hace
// checkoutStateFromDb.ts) a partir de `items` y `address`, para que nunca puedan desincronizarse de la
// base real. Al cerrar la venta, este estado se vuelca a Order y deja de ser la verdad - Order sigue
// siendo la verdad historica.
model SaleState {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String       @unique
  // [{productId, productName, variantId, variantLabel, quantity, unitPrice, currency}] - mismo shape
  // que ResolvedOrderItem (orders/service.ts), validado contra catalogo en cada set_order_item.
  items          Json         @default("[]")
  // Snapshot de ESTA conversacion/venta, no del perfil del cliente (Customer tiene sus propios campos
  // homonimos) - un mismo cliente puede pedir que un pedido puntual llegue a otra direccion. Si estan
  // vacios, saleState.ts cae al dato de Customer; lo que se escribe aca tambien se duplica a Customer
  // (dual-write) para que la proxima conversacion arranque con el ultimo dato real.
  customerName   String?
  idNumber       String?
  deliveryPhone  String?
  address        String?
  shippingModality ShippingPaymentModality?
  paymentMethodId  String?
  // Reservado para Fase 4 (PENDING_OWNER_QUESTION) y Fase 6 (CONFIG_INCOMPLETE) - String simple, no
  // enum: no le fijamos valores a fases que todavia no se disenaron. Sin uso en esta fase.
  blockedBy      String?
  // Fase 5 del plan maestro (2026-09-15), causa raiz C2: nombres (con variante si aplica) de las fotos/
  // videos que YA se mandaron de verdad en esta conversacion, escrito por tools.ts en el momento del
  // envio real - reemplaza reconstruir esa lista leyendo el historial con MEDIA_CAPTION_PATTERN.
  // Independiente de Business.saleStateEnabled, igual que blockedBy: no mandar fotos repetidas no es una
  // funcion del motor de venta.
  mediaSent      String[]     @default([])
  // Ciudad para la que get_shipping_rate_for_city encontro una tarifa real en esta conversacion,
  // escrita por el servidor en el momento del match. Deliberadamente NO entra en el calculo de
  // getSaleState (ciudad/costo se siguen derivando de `address`): es evidencia de lo que el servidor
  // sabe, no un dato de entrega. Independiente de Business.saleStateEnabled, igual que mediaSent.
  shippingCity   String?
  // Cuantas veces seguidas el cliente mando una foto/video para identificar un producto sin que el turno
  // lo resolviera (ni un envio real ni una escalacion al dueno) - ver shouldForcePhotoEscalation en
  // agent.ts. Se resetea a 0 apenas se resuelve; nunca se lee de texto.
  photoIdStreak  Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// EL PRECIO ACORDADO (2026-09-16). Un precio que la duena autorizo para ESTE cliente y estos productos,
// distinto del de catalogo. Antes de esta tabla un descuento vivia unicamente como texto en el chat: el
// agente no lo tenia como dato y cobraba lo unico que tenia, el catalogo (caso real, conversacion
// cmu4gykpm003le82keve7ngck del 2026-09-16 - la duena dejo los AirPods en 70 y el Alexa en 65, y el
// resumen salio con 75.000 y 70.000, dos veces).
//
// Cuando existe una fila aca, ESE es el precio del item: el catalogo pasa a ser el valor por defecto, no
// la verdad. Solo dos cosas escriben esta tabla, y ninguna de las dos es el modelo ni el cliente: la
// confirmacion explicita de la duena a una PendingOwnerQuestion de kind PRICE (src/routes/whatsapp.ts) y
// el panel (src/routes/admin/conversations.ts). Un precio dicho por el cliente no llega aca por ningun
// camino, y hay una prueba que lo fija.
model AgreedPrice {
  id             String            @id @default(cuid())
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  productId      String
  // El variantId, o "" cuando la linea no tiene variante. Cadena vacia y no NULL porque en Postgres dos
  // NULL no chocan entre si, asi que un @@unique con una columna nullable no impediria dos filas para el
  // mismo producto sin variante.
  variantKey     String            @default("")
  unitPrice      Decimal           @db.Decimal(12, 2)
  currency       String
  source         AgreedPriceSource
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([conversationId, productId, variantKey])
  @@index([conversationId])
}

// De donde salio la autorizacion. Las dos son la duena: por WhatsApp respondiendo y confirmando la
// pregunta del agente, o a mano desde el panel sobre la venta abierta. No hay un tercer valor, y
// especialmente no hay uno para "lo dijo el cliente".
enum AgreedPriceSource {
  OWNER_REPLY
  ADMIN_PANEL
}

model OrderItem {
  id           String  @id @default(cuid())
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  productId    String?
  productName  String
  // Denormalized the same way productId/productName already are (no @relation, resolved at read time,
  // same rationale as ShippingCityRule.label above) - which color/size actually sold, so order summaries
  // and owner notifications can show it without a join, and it survives the variant later being renamed
  // or deleted.
  variantId    String?
  variantLabel String?
  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)
  // El precio que se le cobro de verdad a este cliente por esta linea, cuando NO es el del catalogo -
  // ver el modelo AgreedPrice. NULL = se cobro el precio de catalogo, que es lo que significaba toda
  // fila anterior a esta columna. unitPrice arriba siempre trae el precio efectivamente cobrado (el
  // acordado si existe), asi que ningun total cambia de forma; esta columna existe para poder DECIR que
  // esa linea salio de un descuento autorizado y no de un precio de catalogo viejo.
  agreedUnitPrice Decimal? @db.Decimal(12, 2)
  currency     String
}

enum TeamRole {
  EMPLOYEE
}

model TeamMember {
  id           String   @id @default(cuid())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId   String
  email        String   @unique
  passwordHash String
  name         String
  role         TeamRole @default(EMPLOYEE)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model FaqEntry {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  question   String
  answer     String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

enum LearnedFaqCandidateStatus {
  PENDING
  APPROVED
  DISCARDED
}

// A {question, answer} pair captured from a resolved ask_owner exchange - the owner already answered
// a customer's question once for real, this surfaces it as a suggested FaqEntry instead of discarding
// it after that one use. Never auto-published: stays PENDING until the owner approves it (possibly
// editing the wording first) from the admin panel. `occurrences` tracks how many times a
// near-duplicate question showed up before being reviewed, as a demand signal.
model LearnedFaqCandidate {
  id             String                    @id @default(cuid())
  business       Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String
  question       String
  answer         String
  conversationId String?
  occurrences    Int                       @default(1)
  status         LearnedFaqCandidateStatus @default(PENDING)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([businessId, status])
}

// Lo que el equipo quiso decirle al cliente cuando la ventana de 24h de WhatsApp ya estaba cerrada.
// Sin esto el texto real se perdia: se mandaba una plantilla generica de reenganche y el dueno tenia
// que acordarse de volver a escribir la respuesta cuando el cliente contestara (caso real 2026-09-14:
// la respuesta a David nunca se entrego y nadie la reenvio). Se encola aca y el webhook la entrega
// sola en cuanto el cliente escribe, porque ese mensaje entrante vuelve a abrir la ventana.
model QueuedOutboundMessage {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  businessId     String
  body           String
  // Quien dejo el mensaje en cola, solo para poder explicarlo en el panel.
  origin         QueuedOutboundOrigin @default(PANEL)
  createdAt      DateTime     @default(now())
  sentAt         DateTime?
  cancelledAt    DateTime?
  // Fase 7: la cola dejo de ser "se intenta una vez cuando el cliente escribe". Un item que fallaba
  // cortaba el drenaje entero de ese cliente y no dejaba rastro. Ahora cada item lleva su propio
  // contador, su proximo intento y el ultimo error, y al agotarse se marca en failedAt (dead-letter)
  // con un DeliveryFailure asociado, en vez de reintentarse para siempre en silencio.
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now())
  lastError      String?
  failedAt       DateTime?

  @@index([conversationId, sentAt])
  @@index([businessId, sentAt])
  @@index([sentAt, nextAttemptAt])
}

enum QueuedOutboundOrigin {
  PANEL
  OWNER_ANSWER
}

// Meta's delivery-status webhook reports failures asynchronously, after the send call already
// returned a wamid looking successful (src/routes/whatsapp.ts) - previously that only hit
// console.error, invisible unless someone went looking in the droplet's pm2 logs over SSH. This
// persists it so the admin panel can surface it live. `critical` marks a failure to reach the
// business owner specifically (recipient matches Business.contactPhone) - that's the dangerous case,
// since it usually means an ask_owner escalation the owner never saw.
model DeliveryFailure {
  id             String   @id @default(cuid())
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String
  wamid          String
  recipientPhone String
  errorCode      Int?
  errorMessage   String
  critical       Boolean  @default(false)
  resolved       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([businessId, resolved])
}

// Chat-style transcript of everything the bot sends to the business owner (alerts, sale
// confirmations, ask_owner escalations) and every reply the owner sends back - this is the only
// place the admin panel can show "did the owner actually get this" as a conversation instead of
// scattered pm2 log lines. `success: false` covers both a synchronous API error (template not
// approved, etc.) and the final fallback failing too - see recordOwnerMessage in
// src/delivery/ownerLog.ts.
model OwnerMessageLog {
  id           String                @id @default(cuid())
  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId   String
  direction    OwnerMessageDirection
  body         String
  success      Boolean               @default(true)
  errorMessage String?
  // `success` solo dice que Meta ACEPTO el envio, no que el dueno lo haya recibido. El acuse real llega
  // despues por el webhook de estados, que matchea por wamid - sin esta columna ese acuse llegaba y se
  // descartaba, porque los mensajes al dueno no viven en `Message`. Nullable: los avisos que fallaron no
  // tienen wamid, y ninguna fila historica lo tiene.
  wamid            String?               @unique
  deliveryStatus   MessageDeliveryStatus?
  deliveryStatusAt DateTime?
  // Conversacion que origino el aviso, cuando la hay. String suelto y no @relation a proposito: esto es
  // un registro de auditoria y tiene que sobrevivir al borrado de la conversacion. Lo escriben por ahora
  // solo los avisos del mecanismo de efectos requeridos (src/ai/requiredEffects.ts), que necesita poder
  // probar con un SELECT por conversacion que el aviso al dueno salio de verdad.
  conversationId String?
  createdAt    DateTime              @default(now())

  @@index([businessId, createdAt])
  @@index([conversationId, createdAt])
}

enum OwnerMessageDirection {
  OUT
  IN
}

model KeyRequest {
  id           String   @id @default(cuid())
  businessName String
  email        String
  phone        String
  planTier     PlanTier
  handled      Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model ActivationKey {
  id               String    @id @default(cuid())
  code             String    @unique
  planTier         PlanTier
  used             Boolean   @default(false)
  usedByBusinessId String?   @unique
  createdAt        DateTime  @default(now())
  usedAt           DateTime?
}

model Product {
  id           String           @id @default(cuid())
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId   String
  name         String
  description  String
  price        Decimal          @db.Decimal(12, 2)
  currency     String           @default("USD")
  stock        Int              @default(0)
  category     String?
  // Single color/size products only (e.g. this exact watch model only comes in black, or this exact
  // shirt row only comes in size M - the same "one product per color/size" pattern this catalog already
  // uses for watches). A product that comes in SEVERAL colors/sizes under one name (e.g. "Diadema M4" in
  // red/yellow/green) uses ProductVariant below instead, which carries its own stock and own photos per
  // color/size.
  color        String?
  size         String?
  active       Boolean          @default(true)
  inquiryCount Int              @default(0)
  media        ProductMedia[]
  variants     ProductVariant[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

// Optional sub-item layer for a product that has multiple color/size options each with independent stock
// and photos (e.g. one headband model in 3 colors, or a clothing item in several sizes). A Product with no
// rows here behaves exactly as before - this is additive, not a replacement for the simple case.
model ProductVariant {
  id        String         @id @default(cuid())
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  color     String?
  size      String?
  stock     Int            @default(0)
  active    Boolean        @default(true)
  media     ProductMedia[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([productId])
}

model ProductMedia {
  id        String          @id @default(cuid())
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  // Set when this photo belongs to one specific variant's color (not the product in general) - lets
  // send_product_media attach only the red headband's photos when the customer asked for red, instead of
  // every photo the product has across all colors.
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId String?
  type      MediaType
  url       String
  s3Key     String
  createdAt DateTime        @default(now())
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

// Por que canal entro este cliente/conversacion. Hoy todo es WHATSAPP (unico canal implementado) y ese
// es el default, asi que ninguna fila existente cambia de comportamiento. Se agrega ahora, antes de
// construir el CRM encima, para que sumar Instagram/Facebook/Mercado Libre mas adelante no obligue a
// migrar datos ni a rehacer la ficha de cliente: el CRM ya lee y muestra el canal desde el dia uno.
// Deliberadamente NO se toca Customer.@@unique([businessId, phoneNumber]) ni se agrega una identidad
// por canal todavia - unificar a la misma persona entre canales (mismo humano en WhatsApp e Instagram)
// es una decision aparte, que recien tiene sentido cuando exista el segundo canal real.
enum Channel {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  MERCADOLIBRE
}

// Etapa del cliente como PERSONA, distinta de Conversation.status (que es el estado de UN ciclo de
// venta). Un cliente puede tener una conversacion SOLD cerrada y seguir siendo RECURRENTE; el status
// por conversacion no puede expresar eso. Default NUEVO para todas las filas existentes.
enum CustomerStage {
  NUEVO
  ACTIVO
  COMPRADOR
  RECURRENTE
  INACTIVO
}

model Customer {
  id            String         @id @default(cuid())
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId    String
  phoneNumber   String
  // Nombre AUTORITATIVO: el que la clienta dijo por chat (save_customer_name) o el que el dueno escribio
  // a mano en el panel. Solo lo cambia una persona a proposito.
  name          String?
  // Lo que WhatsApp reporta en cada webhook (contacts[0].profile.name): el nombre que la persona puso en
  // SU propio perfil. Va aparte de `name` a proposito - lo refrescamos en cada mensaje y la persona puede
  // cambiarlo cuando quiera, asi que si compartiera campo con `name` un cambio de perfil ajeno borraria
  // el nombre bueno. Para mostrar se usa name ?? whatsappProfileName ?? phoneNumber.
  whatsappProfileName String?
  idNumber      String?
  deliveryPhone String?
  email         String?
  address       String?
  stage         CustomerStage  @default(NUEVO)
  channel       Channel        @default(WHATSAPP)
  // Como llego este cliente (campana, referido, etc). Texto libre a proposito: cada negocio tiene su
  // propio vocabulario de origen y no hay ninguno que sirva para todos.
  source        String?
  // Ultimo mensaje intercambiado con este cliente, en cualquiera de sus conversaciones. Existe para
  // que la lista de clientes del CRM pueda ordenar y paginar por recencia con un indice, en vez de
  // traer todas las conversaciones del negocio y agrupar en memoria (ver P10 del plan). Lo mantiene
  // recordMessage(); la migracion lo rellena con el ultimo mensaje real de cada cliente.
  lastContactAt DateTime?
  tags          String[]       @default([])
  notes         CustomerNote[]
  conversations Conversation[]
  orders        Order[]
  createdAt     DateTime       @default(now())

  @@unique([businessId, phoneNumber])
  @@index([businessId, lastContactAt])
}

// Notas internas del negocio sobre un cliente. Nunca se le mandan al cliente ni entran al prompt del
// bot - son para el equipo humano que atiende.
model CustomerNote {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  body       String
  // Nombre de quien la escribio, resuelto al momento de crearla (dueño o empleado). Se guarda como
  // texto y no como FK a TeamMember a proposito: si ese empleado se borra despues, la nota sigue
  // diciendo quien la escribio en vez de quedar huerfana.
  authorName String?
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

// Catalogo de etiquetas del negocio: le da color y autocompletado a los strings que ya viven en
// Customer.tags. NO reemplaza ese String[] - una etiqueta escrita a mano que no este en esta tabla
// sigue funcionando exactamente igual que antes, solo se muestra con el color por defecto.
model CustomerTag {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  label      String
  color      String   @default("#5c6e65")
  createdAt  DateTime @default(now())

  @@unique([businessId, label])
}

model Conversation {
  id                           String                 @id @default(cuid())
  customer                     Customer               @relation(fields: [customerId], references: [id])
  customerId                   String
  // Canal por el que llego esta conversacion (ver enum Channel). Default WHATSAPP: hoy es el unico
  // canal implementado y toda fila existente queda igual.
  channel                      Channel                @default(WHATSAPP)
  status                       ConversationStatus     @default(NEW)
  intent                       ConversationIntent?
  // Fase 9 del plan maestro (2026-09-15): flag_conversation_intent silenciaba el bot sin que el dueno
  // supiera si el cliente lo pidio con sus propias palabras o si el modelo lo dedujo del contexto - un
  // "cerrar conversation" mal leido como SOLICITA_AGENTE se veia identico a un pedido real. Lo llena
  // setConversationIntent; null para toda fila anterior a esta fase (nunca se le pregunto al modelo).
  intentExplicit               Boolean?
  humanControl                 Boolean                @default(false)
  humanControlAckSent          Boolean                @default(false)
  // Set/reset by setHumanControl every time humanControl flips (either direction) - the clock the
  // stalled-conversation watchdog measures against (jobs/escalationReminder.ts), independent of
  // PendingOwnerQuestion.createdAt so a flag_conversation_intent/manual-takeover escalation (neither of
  // which creates a PendingOwnerQuestion) is still caught if nobody answers it.
  humanControlSince            DateTime?
  stalledReminderStage         Int                    @default(0)
  stalledReminderSentAt        DateTime?
  followUpSentAt               DateTime?
  // Fase 9: una vez que la conversacion paso a ABANDONED con items en SaleState, jobs/abandonment.ts
  // manda la plantilla de recuperacion de carrito UNA sola vez - este flag evita reenviarla en cada
  // pasada del job mientras siga sin entregarse marcada como exitosa (mismo patron que followUpSentAt).
  // Se limpia si la conversacion se reactiva (getOrCreateOpenConversation), para que un abandono
  // posterior pueda volver a mandarla.
  cartRecoverySentAt           DateTime?
  // wamid del mensaje que el dueno tiene que responder. Sirve para matchear su respuesta citada; NO es
  // lo que define que haya una confirmacion viva - cuando los tres escalones de envio fallan no hay
  // wamid y la confirmacion existe igual. Eso lo marca pendingConfirmationAskedAt.
  pendingConfirmationMessageId String?                @unique
  pendingOrderSummary          String?
  pendingOrderItems            Json?
  // Momento en que se le pidio la confirmacion al dueno por primera vez. Es la marca de "hay una
  // confirmacion viva" y el reloj contra el que miden el perseguidor (Business.ownerReminderMinutes) y
  // el vencimiento (Business.ownerQuestionTimeoutHours), igual que PendingOwnerQuestion.createdAt.
  pendingConfirmationAskedAt   DateTime?
  // Ultimo reintento del perseguidor. A diferencia de PendingOwnerQuestion.remindedAt, este no es un
  // "una sola vez": se insiste cada ownerReminderMinutes hasta que el dueno responda o venza el plazo.
  pendingConfirmationRemindedAt DateTime?
  // Cuantas veces se intento hacerle llegar la pregunta (el pedido inicial cuenta como 1).
  pendingConfirmationAttempts  Int                    @default(0)
  // Por cual escalon de la escalera salio el ultimo intento. NONE = no salio por ninguno; el
  // perseguidor lo vuelve a intentar.
  pendingConfirmationChannel   OwnerConfirmationChannel?
  // El aviso salio por plantilla (unico contenido que cruza la ventana de 24h cerrada), asi que el
  // mensaje real con botones sigue debiendo salir: se manda apenas el dueno escriba cualquier cosa, que
  // es lo que reabre su ventana.
  pendingConfirmationButtonsQueued Boolean            @default(false)
  // Cuando toca el proximo reintento. Se guarda en vez de calcularse en la consulta porque el intervalo
  // crece con el numero de intento (ver CONFIRMATION_REMINDER_STEPS): con cadencia fija alcanzaba un
  // `lte` sobre la fecha del ultimo aviso, con espaciado creciente no. Ademas es lo que el panel muestra
  // como "proximo aviso".
  pendingConfirmationNextAttemptAt DateTime?
  // Cuantas veces se gasto la plantilla onix_owner_alert en esta confirmacion. Es UTILITY: se factura
  // por mensaje, y si no contesto la primera, la numero cuarenta no la va a despertar.
  pendingConfirmationTemplatesSent Int                @default(0)
  // Cuando salio la ultima. Sin esto, el tope se gastaba entero en los primeros 15 minutos y despues no
  // quedaba forma de alcanzarla en las 23 horas que faltan.
  pendingConfirmationLastTemplateAt DateTime?
  pendingOwnerQuestions        PendingOwnerQuestion[]
  contextSummary               String?
  contextSummarizedUpTo        Int?
  mediaSentProductIds          String[]               @default([])
  // Fase B del plan de catalogo y medios (2026-09-16), pieza 4: los ids de producto que el servidor
  // REALMENTE le presento al cliente en el ultimo bloque de catalogo, en el mismo orden en que salieron
  // numerados. Es contra esto que se resuelve "el 3" del turno siguiente - antes eso dependia de que el
  // modelo se acordara de su propia lista, que es justo lo que esta fase le quita de las manos.
  lastPresentedProductIds      String[]               @default([])
  unreadCount                  Int                    @default(0)
  order                        Order?
  saleState                    SaleState?
  agreedPrices                 AgreedPrice[]
  messages                     Message[]
  queuedOutbound               QueuedOutboundMessage[]
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt

  @@index([pendingConfirmationAskedAt])
}

// Por cual escalon de la escalera de envio salio la pregunta de confirmacion al dueno:
// botones -> texto libre -> plantilla onix_owner_alert. NONE es "no salio por ninguno".
enum OwnerConfirmationChannel {
  BUTTONS
  TEXT
  TEMPLATE
  NONE
}

// One row per question escalated to the owner, instead of a single field on Conversation - a customer
// asking several distinct questions before the owner replies to the first one used to overwrite that
// single field each time, so her reply to an earlier question could never be matched back once a later
// question replaced it. Each escalation now gets its own trackable row, matched by the wamid of the
// alert the owner actually replies to.
model PendingOwnerQuestion {
  id             String                   @id @default(cuid())
  conversation   Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  wamid          String                   @unique
  question       String
  kind           PendingOwnerQuestionKind @default(TEXT)
  // Las RANURAS que el servidor espera llenar con la respuesta del dueno, escritas por el servidor
  // cuando manda la pregunta. Solo para kind PRICE hoy: { items: [{productId, variantKey, productName,
  // variantLabel, quantity, unitPrice, currency}], propuesta?: number[] }. La respuesta del dueno se
  // interpreta SOLO contra estas ranuras (N items, un numero cada uno) y `propuesta` es lo que el
  // servidor entendio, todavia sin efecto: un precio acordado no existe hasta que la duena confirma esa
  // propuesta. NULL para TEXT y PHOTO_PRODUCT, que es lo que era toda fila anterior a esta columna.
  payload        Json?
  createdAt      DateTime                 @default(now())
  remindedAt     DateTime?

  @@index([conversationId])
}

// PHOTO_PRODUCT: the owner was sent the customer's actual photo/video to identify (ask_owner_about_photo
// in src/ai/tools.ts), not a plain text question - handleOwnerReply answers it differently (tries to
// resolve the owner's reply to a real catalog product and send its photo back, instead of forwarding the
// owner's raw text as-is).
// PRICE: el agente le pregunto al dueno por el precio de un pedido concreto (ask_owner_about_price en
// src/ai/tools.ts). La pregunta lleva los items exactos y sus precios actuales en `payload`, y la
// respuesta se resuelve contra esas ranuras en vez de reenviarse tal cual al cliente - ver la rama PRICE
// de handleOwnerReply en src/routes/whatsapp.ts.
enum PendingOwnerQuestionKind {
  TEXT
  PHOTO_PRODUCT
  PRICE
}

enum ConversationStatus {
  NEW
  INTERESTED
  QUOTED
  NEGOTIATING
  SOLD
  LOST
  // Fase 9 del plan maestro (2026-09-15), causa raiz C1+eje 18: el 61% de las conversaciones se quedaba
  // en NEW para siempre - nada las cerraba y no contaban como perdida. Distinto de LOST (rechazo
  // EXPLICITO del cliente): esta la pone jobs/abandonment.ts cuando el cliente deja de escribir por
  // Business.abandonedAfterHours. No es terminal como LOST - getOrCreateOpenConversation la reabre (vuelve
  // a NEW) si el cliente vuelve a escribir, para no perder el SaleState/carrito que ya tenia armado.
  ABANDONED
}

enum ConversationIntent {
  PQR
  DEVOLUCION
  NO_RECIBIDO
  SOLICITA_AGENTE
}

model Message {
  id                String       @id @default(cuid())
  conversation      Conversation @relation(fields: [conversationId], references: [id])
  conversationId    String
  role              MessageRole
  content           String
  mediaS3Key        String?
  mediaType         MediaType?
  imageAnalysis     String?
  whatsappMessageId String?      @unique
  relatedProductId  String?
  // Fase 7 del plan maestro (2026-09-15): Meta manda el estado de entrega (sent/delivered/read/failed)
  // via el webhook de `statuses`, matcheado por whatsappMessageId - antes se descartaba en un
  // console.log (whatsapp.ts) y el panel no podia mostrar si un mensaje llego. Solo aplica a mensajes
  // ASSISTANT (los unicos que salen con un wamid propio); "failed" ya se registra aparte como
  // DeliveryFailure, asi que ese estado no vive aca.
  deliveryStatus    MessageDeliveryStatus?
  deliveryStatusAt  DateTime?
  createdAt         DateTime     @default(now())
}

enum MessageRole {
  CUSTOMER
  ASSISTANT
  SYSTEM
}

enum MessageDeliveryStatus {
  SENT
  DELIVERED
  READ
}

enum AiUsageKind {
  CHAT
  VISION
  VISION_ESCALATION
}

model AiUsageLog {
  id              String      @id @default(cuid())
  business        Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId      String
  conversationId  String?
  kind            AiUsageKind
  model           String
  cacheHitTokens  Int         @default(0)
  cacheMissTokens Int         @default(0)
  outputTokens    Int         @default(0)
  costUsd         Float
  createdAt       DateTime    @default(now())

  @@index([businessId, createdAt])
}

// Fase F, 2026-09-13 audit (F9): none of the backend safety nets in agent.ts (loop exhaustion,
// applyClaimBackstops repairs) left any queryable trace before this - only a console.error/warn nobody
// reads unless they happen to be tailing production logs. One row per intervention, cheap and
// best-effort (recordAgentIncident in agent.ts never lets a logging failure break the real reply).
// Fase B del plan de catalogo y medios (2026-09-16), pieza 7 (adelantada de la Fase A): una fila por
// turno del agente. Hasta ahora, saber que hizo un turno exigia cruzar AiUsageLog, Message y
// mediaSentProductIds y deducir; eso es arqueologia, y es lo que dejo vivir dias al defecto de catalogo
// sin que nadie lo viera. Se escribe best-effort: un fallo al registrar NUNCA rompe la respuesta real
// (mismo patron que recordAgentIncident).
model AgentTurn {
  id             String   @id @default(cuid())
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String
  conversationId String
  // Cuantas vueltas dio el lazo de tool-calling antes de devolver texto.
  iterations     Int      @default(0)
  // Herramientas llamadas EN ORDEN, incluidos los repetidos - "search_products, send_product_media".
  toolsCalled    String[] @default([])
  // Herramienta que se forzo por tool_choice en la primera llamada, si se forzo alguna. Junto con
  // toolsCalled es lo que permite medir la tasa de cumplimiento de tool_choice, que hoy no tiene numero.
  forcedTool     String?
  // Alcance que resolvio el servidor: "none", "one:<producto>", "group:<categoria> (n)", "all:n".
  scope          String   @default("none")
  // Texto exacto del bloque COMPUESTO POR EL SERVIDOR, en orden - se haya enviado como mensaje aparte o
  // haya viajado adentro del mensaje del modelo (marca {{BLOQUE_CATALOGO}}, 282c8f1). Se guarda igual en
  // los dos casos a proposito: la auditoria tiene que poder ver el bloque que compuso el servidor sin
  // depender de donde termino saliendo. catalogInlined dice cual de los dos casos fue - sin mirarlo, una
  // fila con blocks no vacio NO significa que el cliente haya recibido un mensaje aparte con ese texto.
  // Desde el camino de UN SOLO AUTOR (2026-09-16) hay un tercer caso: con catalogAuthor = "modelo" el
  // bloque de esta columna NO se envio nunca - se compuso solo como fallback y el agente escribio el
  // mensaje el mismo.
  blocks         String[] @default([])
  // true = el modelo puso la marca {{BLOQUE_CATALOGO}} y el bloque de arriba viajo adentro de su mensaje;
  // false = salio como mensaje aparte, o no hubo bloque. Es el denominador de la tasa de omision de la
  // marca, que es el numero con el que se sabe si el cambio del 2026-09-16 sirvio.
  catalogInlined Boolean  @default(false)
  // UN SOLO AUTOR (2026-09-16). Quien escribio el mensaje de catalogo que recibio el cliente:
  // "modelo" = el agente lo escribio entero con los datos estructurados del servidor y la verificacion
  // contra el catalogo lo aprobo; "servidor" = la verificacion fallo dos veces y salio el bloque
  // compuesto, que es texto leido de la base. null = este turno no paso por ese camino (alcance
  // distinto de "one", o sin alcance). Es el denominador de la tasa de caida al fallback: el incidente
  // solo da el numerador.
  catalogAuthor  String?
  // Ids de producto cuyos medios salieron con los bloques de este turno.
  mediaProductIds String[] @default([])
  // Pieza 5 del plan de catalogo y medios, EN MODO SOMBRA: lo que la validacion contra el catalogo real
  // HABRIA marcado en el texto de este turno, un JSON por hallazgo ({kind, value, line}). Nada de esto
  // cambia lo que recibe el cliente - la activacion es un cambio aparte, despues de 48h de datos.
  // Array vacio = el turno no marco nada, que es el caso normal.
  shadowFindings String[] @default([])
  createdAt      DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([conversationId, createdAt])
}

model AgentIncident {
  id             String            @id @default(cuid())
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String
  conversationId String?
  kind           AgentIncidentKind
  // Fase 0 del plan maestro (2026-09-15): nombre del guard/patron que disparo este incidente
  // (p.ej. "variant_denial", "media_promise_retraction"). Sin esto, P5 (backstops por 100 turnos)
  // solo puede reportarse agregado; con esto se puede desglosar por guard, que es lo que deja ver
  // cuando una fase realmente elimino una clase de falla en vez de solo bajar el conteo total.
  // Nullable y sin backfill: las filas viejas quedan sin guard, no se les inventa uno.
  guard          String?
  detail         String
  createdAt      DateTime          @default(now())

  @@index([businessId, createdAt])
}

enum AgentIncidentKind {
  LOOP_EXHAUSTED
  BACKSTOP_INTERVENTION
  DEGRADED_REPLY
  // Una API externa (Anthropic, DeepSeek, Groq) rechazo o fallo una llamada. Existe porque esos
  // caminos atrapan el error y siguen sin romper la conversacion: sin una fila aca, un fallo total
  // y permanente se ve identico a "esta funcion nunca hizo falta". Ver la llave de Anthropic sin
  // workspace, que dejo la escalacion de vision muerta semanas sin que nadie se enterara.
  EXTERNAL_API_FAILURE
  // La respuesta del bot tardo mas de STALE_REPLY_MINUTES en generarse y se descarto sin mandarla.
  // Pasa cuando el proveedor de IA esta degradado: el 2026-09-14, con DeepSeek caido, una respuesta
  // salio 30 minutos despues del mensaje del cliente, ya fuera de contexto. La conversacion pasa a
  // control humano en vez de mandar algo viejo.
  STALE_REPLY_DISCARDED
  // Correccion Fase 4 del plan maestro (2026-09-15): una PendingOwnerQuestion (ask_owner) llego a
  // Business.ownerQuestionTimeoutHours sin respuesta del dueno. blockedBy se limpia solo (ver
  // saleState.ts) y la conversacion pasa a humanControl - antes se quedaba muda para siempre.
  OWNER_QUESTION_TIMEOUT
  // Fase 9: jobs/abandonment.ts paso esta conversacion a ABANDONED por inactividad del cliente.
  CONVERSATION_ABANDONED
  // Fase 9: una escalacion de flag_conversation_intent (PQR/devolucion/no_recibido/pide agente) paso
  // Business.intentEscalationTimeoutHours sin que el dueno respondiera - se le devolvio el control al
  // bot solo, ver conversationIntent en jobs/escalationReminder.ts.
  INTENT_ESCALATION_TIMEOUT
  // Se vencio Business.ownerQuestionTimeoutHours con una confirmacion de venta sin responder: el cliente
  // pago y el dueno nunca contesto "¿Te llego el pago?". La conversacion pasa a control manual. Es el
  // caso mas caro de todos, porque hay plata de por medio.
  SALE_CONFIRMATION_TIMEOUT
}

// Fase 8, punto 5 del plan maestro (2026-09-15): las sesiones del panel vivian en la memoria del
// proceso (el MemoryStore por omision de express-session). Cada `pm2 restart` - 103 en lo que va del
// registro - deslogueaba a todo el mundo, y ademas el propio express-session avisa que ese store
// pierde memoria y no sirve para produccion.
//
// El nombre de la tabla y sus columnas los fija connect-pg-simple, no nosotros: esta modelada aca para
// que Prisma la conozca y no la reporte como drift, no para usarla desde el codigo.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("session")
}
